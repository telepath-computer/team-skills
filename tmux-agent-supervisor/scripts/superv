# -- utilities ----------------------------------------------------------------

def eprint(*args: Any) -> None:
    print(*args, file=sys.stderr)


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def ensure_dirs() -> None:
    for d in (WORKERS_DIR, CURSORS_DIR, NOTES_DIR, HEARTBEATS_DIR, POINTER_FILES_DIR, TMUX_CURSORS_DIR):
        d.mkdir(parents=True, exist_ok=True)


def trunc(text: str, limit: int) -> str:
    s = "" if text is None else str(text)
    if len(s) <= limit:
        return s
    return f"{s[:limit]}... ({len(s)} chars)"


def single_line(text: str, limit: int) -> str:
    return trunc(str(text).replace("\n", "\\n"), limit)


def normalize_whitespace(text: Any) -> str:
    """Turn arbitrary persisted text into one readable display line."""
    return re.sub(r"\s+", " ", "" if text is None else str(text)).strip()


def clip_overview(text: Any, limit: int, *, preserve_tail: bool = False) -> Tuple[str, bool]:
    """Character-wise clipping for compact overview lines.

    Assistant prose and tool results preserve a small tail because conclusions
    and errors often appear there. Tool-call arguments favor the leading text,
    which identifies the command, path, pattern, query, or URL.
    """
    value = normalize_whitespace(text)
    if len(value) <= limit:
        return value, False
    if limit <= 1:
        return "…", True
    if preserve_tail and limit >= 24:
        tail = max(12, limit // 4)
        head = limit - tail - 1
        return f"{value[:head].rstrip()}…{value[-tail:].lstrip()}", True
    return f"{value[:limit - 1].rstrip()}…", True


def reasoning_labels(text: Any) -> List[str]:
    """Readable plaintext intent labels from a persisted reasoning summary."""
    raw = "" if text is None else str(text)
    labels = []
    for part in re.split(r"\n\s*\n", raw):
        value = normalize_whitespace(part)
        if value.startswith("**") and value.endswith("**") and len(value) >= 4:
            value = value[2:-2].strip()
        if value:
            labels.append(value)
    return labels


def meaningful_stop_reason(reason: Any, *, has_tool_call: bool = False) -> Optional[str]:
    """Exceptional stop reasons worth showing in routine observations."""
    value = "" if reason is None else str(reason).strip()
    normalized = re.sub(r"[-_]", "", value).lower()
    if normalized in {"stop", "endturn"}:
        return None
    if normalized == "tooluse" and has_tool_call:
        return None
    return value or None


def common_prefix_length(left: str, right: str) -> int:
    size = 0
    for left_char, right_char in zip(left, right):
        if left_char != right_char:
            break
        size += 1
    return size


def unique_prefixes(values: List[str], minimum: int = LOCATOR_PREFIX_MIN) -> Dict[str, str]:
    """Shortest unique prefixes, found from each sorted value's neighbors.

    In sorted order, the value sharing the longest prefix must be adjacent.
    Comparing only those neighbors avoids comparing every session id with
    every other id during each watch.
    """
    strings = sorted(str(value) for value in values if value)
    out: Dict[str, str] = {}
    for index, value in enumerate(strings):
        previous = common_prefix_length(value, strings[index - 1]) if index else 0
        following = common_prefix_length(value, strings[index + 1]) if index + 1 < len(strings) else 0
        needed = max(previous, following) + 1
        size = min(len(value), max(minimum, needed))
        out[value] = value[:size]
    return out


def resolve_unique_prefix(values: List[str], target: str, label: str = "id") -> str:
    if target in values:
        return target
    matches = [value for value in values if value.startswith(target)]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise ValueError(f"{label} not found: {target}")
    prefixes = unique_prefixes(matches)
    choices = ", ".join(prefixes[value] for value in matches[:12])
    suffix = " …" if len(matches) > 12 else ""
    raise ValueError(f"ambiguous {label} prefix '{target}'; use one of: {choices}{suffix}")


def fmt_ts(ts: Any) -> str:
    if not ts:
        return "?"
    try:
        if isinstance(ts, (int, float)):
            seconds = ts / 1000 if ts > 1e12 else ts
            return datetime.fromtimestamp(seconds).strftime("%H:%M:%S")
        return datetime.fromisoformat(str(ts).replace("Z", "+00:00")).strftime("%H:%M:%S")
    except Exception:
        return str(ts)[:19]


def shell_escape(s: str) -> str:
    return shlex.quote(s)


# -- registry -----------------------------------------------------------------

def registry_path(worker_id: str) -> Path:
    return WORKERS_DIR / f"{worker_id}.json"


def load_record(worker_id: str) -> Dict[str, Any]:
    p = registry_path(worker_id)
    if not p.exists():
        raise ValueError(f"Unknown worker id: {worker_id} (no registry entry at {p})")
    return json.loads(p.read_text(encoding="utf-8"))


def save_record(rec: Dict[str, Any]) -> None:
    ensure_dirs()
    p = registry_path(rec["id"])
    rec.setdefault("created_at", now_iso())
    rec["updated_at"] = now_iso()
    p.write_text(json.dumps(rec, indent=2), encoding="utf-8")


def list_records() -> List[Dict[str, Any]]:
    ensure_dirs()
    return [
        json.loads(p.read_text(encoding="utf-8"))
        for p in sorted(WORKERS_DIR.glob("*.json"))
    ]


# -- cursor -------------------------------------------------------------------

def cursor_path(worker_id: str) -> Path:
    return CURSORS_DIR / f"{worker_id}.json"


def load_cursor(worker_id: str) -> Optional[Dict[str, Any]]:
    p = cursor_path(worker_id)
    if not p.exists():
        return None
    return json.loads(p.read_text(encoding="utf-8"))


def save_cursor(worker_id: str, payload: Dict[str, Any]) -> None:
    ensure_dirs()
    payload = dict(payload)
    payload["updated_at"] = now_iso()
    cursor_path(worker_id).write_text(json.dumps(payload, indent=2), encoding="utf-8")


def reset_cursor(worker_id: str) -> None:
    p = cursor_path(worker_id)
    if p.exists():
        p.unlink()


# -- tmux mutex --------------------------------------------------------------

@contextlib.contextmanager
def tmux_lock(timeout_s: float = 30.0, poll_s: float = 0.05):
    """Strong mutex serializing tmux interactions across superv invocations.

    tmux's paste buffer is global per server, so two concurrent `superv send`
    calls can interleave: caller A loads text into the buffer, caller B loads
    its own text (overwriting A), then A pastes and delivers B's text to A's
    worker — cross-contaminating the two workers. Holding an exclusive flock
    across each tmux critical section makes those sections atomic.

    flock is released automatically when the holding process exits, so a
    crashed or killed peer cannot wedge the lock. A bounded timeout prevents a
    stuck peer from blocking everyone forever.
    """
    ensure_dirs()
    f = open(TMUX_LOCK_FILE, "w")
    deadline = time.time() + timeout_s
    try:
        while True:
            try:
                fcntl.flock(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() >= deadline:
                    raise TimeoutError(
                        f"timed out after {timeout_s:.0f}s waiting for tmux lock {TMUX_LOCK_FILE}; "
                        "another superv process may be stuck inside a tmux critical section"
                    )
                time.sleep(poll_s)
        yield
    finally:
        try:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
        finally:
            f.close()


# -- tmux helpers -------------------------------------------------------------

def tmux_capture(target: str, lines: int = 200) -> str:
    with tmux_lock():
        try:
            out = subprocess.check_output(
                ["tmux", "capture-pane", "-t", target, "-p", "-S", f"-{lines}"],
                stderr=subprocess.STDOUT,
            )
            return out.decode("utf-8", errors="replace")
        except subprocess.CalledProcessError as e:
            return e.output.decode("utf-8", errors="replace") if e.output else ""


def tmux_capture_full(target: str) -> str:
    with tmux_lock():
        try:
            out = subprocess.check_output(
                ["tmux", "capture-pane", "-t", target, "-p", "-S", "-"],
                stderr=subprocess.STDOUT,
            )
            return out.decode("utf-8", errors="replace")
        except subprocess.CalledProcessError as e:
            return e.output.decode("utf-8", errors="replace") if e.output else ""


def tmux_send_keys(target: str, text: str) -> None:
    """Send arbitrary text (single or multi-line) to a tmux pane, then submit.

    Uses tmux's paste-buffer mechanism rather than `send-keys <text>` so that
    embedded newlines arrive as literal newlines in the worker's input field
    rather than being interpreted as Enter (which would submit prematurely).
    Behavior:
      1. Load `text` into the tmux paste buffer via stdin.
      2. Paste it into the target pane (deleting the buffer afterwards).
      3. Send a single Enter to submit.
    Works for any worker whose TUI accepts a paste followed by Enter.
    """
    if not text:
        return
    with tmux_lock():
        p = subprocess.Popen(["tmux", "load-buffer", "-"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
        if p.returncode != 0:
            raise RuntimeError(f"tmux load-buffer failed (exit {p.returncode})")
        # -d delete buffer after paste, -p bracketed paste, -r keep LF as LF (don't translate to CR).
        # Without -r, tmux's default LF→CR substitution would treat every newline as Enter, submitting
        # each paragraph as a separate message instead of letting the worker accumulate the full draft.
        subprocess.check_call(["tmux", "paste-buffer", "-d", "-p", "-r", "-t", target])
        subprocess.check_call(["tmux", "send-keys", "-t", target, "Enter"])


def tmux_send_enter(target: str) -> None:
    with tmux_lock():
        subprocess.check_call(["tmux", "send-keys", "-t", target, "Enter"])


def tmux_pane_path(target: str) -> Optional[str]:
    with tmux_lock():
        try:
            out = subprocess.check_output(
                ["tmux", "display-message", "-pt", target, "#{pane_current_path}"],
                stderr=subprocess.STDOUT,
            )
            return out.decode("utf-8", errors="replace").strip()
        except subprocess.CalledProcessError:
            return None


def tmux_pane_pid(target: str) -> Optional[int]:
    with tmux_lock():
        try:
            out = subprocess.check_output(
                ["tmux", "display-message", "-pt", target, "#{pane_pid}"],
                stderr=subprocess.STDOUT,
            )
            return int(out.decode("utf-8", errors="replace").strip())
        except (subprocess.CalledProcessError, ValueError):
            return None


def tmux_list_panes() -> List[Dict[str, Any]]:
    with tmux_lock():
        fmt = "#{session_name}:#{window_index}.#{pane_index}|#{window_name}|#{pane_pid}|#{pane_current_command}|#{pane_current_path}"
        try:
            out = subprocess.check_output(
                ["tmux", "list-panes", "-a", "-F", fmt],
                stderr=subprocess.STDOUT,
            )
        except subprocess.CalledProcessError:
            return []
        panes = []
        for line in out.decode("utf-8", errors="replace").splitlines():
            parts = line.split("|", 4)
            if len(parts) != 5:
                continue
            panes.append({
                "target": parts[0],
                "window_name": parts[1],
                "pid": int(parts[2]) if parts[2].isdigit() else None,
                "cmd": parts[3],
                "path": parts[4],
            })
        return panes


def proc_descendants_running(pid: int, name: str) -> Optional[int]:
    """Find a descendant process of pid whose comm matches `name`."""
    try:
        out = subprocess.check_output(["pgrep", "-P", str(pid), name], stderr=subprocess.DEVNULL)
        for line in out.decode().splitlines():
            if line.strip().isdigit():
                return int(line.strip())
    except subprocess.CalledProcessError:
        pass
    return None


# -- http helpers (OpenCode) --------------------------------------------------

def http_get(path: str, directory: str = "/", timeout: int = 10) -> Any:
    req = urllib.request.Request(f"{OC_BASE}{path}", headers={"x-opencode-directory": directory})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def http_post(path: str, body: Dict[str, Any], directory: str = "/", timeout: int = 30) -> Tuple[int, Any]:
    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        f"{OC_BASE}{path}",
        data=data,
        method="POST",
        headers={"x-opencode-directory": directory, "content-type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read()
            if not raw:
                return r.status, None
            try:
                return r.status, json.loads(raw)
            except Exception:
                return r.status, raw.decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        body_text = e.read().decode("utf-8", errors="replace") if e.fp else ""
        return e.code, body_text


# -- adapters base ------------------------------------------------------------

class OverviewLine:
    """One bounded line in an overflow overview."""

    def __init__(self, locator: str, ts: str, kind: str, text: Any = "", *,
                 limit: int = OVERVIEW_TEXT_TRUNC, preserve_tail: bool = False):
        self.locator = locator
        self.ts = ts
        self.kind = kind
        self.text, self.truncated = clip_overview(text, limit, preserve_tail=preserve_tail)

    def render(self) -> str:
        suffix = f" {self.text}" if self.text else ""
        return f"{self.ts} {self.locator} {self.kind}{suffix}"


class Entry:
    """Uniform rendered entry shape returned by adapters.

    One persisted entry may contain several overview lines. In particular,
    every tool call remains individually visible rather than being replaced by
    an activity count.
    """

    def __init__(self, eid: str, ts: str, kind: str, header: str, body: str = "",
                 overview: Optional[List[OverviewLine]] = None,
                 cursor_after: Optional[Dict[str, Any]] = None):
        self.id = eid
        self.ts = ts
        self.kind = kind
        self.header = header
        self.body = body
        self.overview = overview or [OverviewLine(eid, ts, kind, body or header)]
        self.cursor_after = cursor_after

    def render(self) -> str:
        if self.body:
            return f"{self.header}\n{self.body}"
        return self.header

    def render_overview(self) -> str:
        return "\n".join(line.render() for line in self.overview)

    def overview_was_truncated(self) -> bool:
        return any(line.truncated for line in self.overview)


def render_entries(entries: List[Entry]) -> str:
    return "\n\n".join(e.render() for e in entries)


def render_overview(entries: List[Entry]) -> str:
    return "\n".join(e.render_overview() for e in entries)


def latest_supervisory_marker(entries: List[Entry]) -> Optional[Tuple[str, str]]:
    """Most recent readable intent or conversation text, excluding tool traffic."""
    for entry in reversed(entries):
        intents = [line for line in entry.overview if line.kind == "intent" and line.text]
        if intents:
            return "intent", intents[-1].text
        messages = [line for line in entry.overview
                    if line.kind in {"assistant", "user"} and line.text]
        if messages:
            return messages[-1].kind, messages[-1].text
    return None


def unread_after_id(cursor: Optional[Dict[str, Any]], *, identity_key: str,
                    identity_value: str, last_key: str, ids: List[Any]) -> Optional[int]:
    """Exact unread count for an id-addressed cursor, or None if it is stale."""
    if cursor is None:
        return len(ids)
    if cursor.get(identity_key) != identity_value:
        return None
    try:
        index = ids.index(cursor.get(last_key))
    except ValueError:
        return None
    return len(ids) - index - 1


# -- adapter: pi --------------------------------------------------------------

def pi_path_key_for_cwd(cwd: str) -> str:
    trimmed = cwd.strip("/")
    return f"--{trimmed.replace('/', '-')}--"


def pi_filename_session_id(path: Path) -> Optional[str]:
    """Session id embedded in a pi session filename (<timestamp>_<id>.jsonl)."""
    stem = path.stem
    if "_" not in stem:
        return None
    return stem.split("_", 1)[1]


def pi_read_session_header(path: Path) -> Optional[Dict[str, Any]]:
    """First line of a pi session JSONL if it is a valid session header."""
    try:
        with path.open("r", encoding="utf-8") as f:
            first = f.readline()
        header = json.loads(first)
    except (OSError, json.JSONDecodeError, ValueError):
        return None
    if not isinstance(header, dict) or header.get("type") != "session":
        return None
    return header


def pi_find_sessions_by_id(session_id: str, session_dir: Optional[str] = None) -> List[Path]:
    """All session files whose identity is exactly `session_id`.

    Identity requires BOTH the filename-embedded id and the header id to equal
    `session_id` — the glob alone would false-match ids that are suffixes of
    other ids. Searches the flat `session_dir` when given (pi --session-dir),
    else every project dir under the default sessions root.
    """
    if session_dir:
        base = Path(session_dir).expanduser()
        candidates = list(base.glob(f"*_{session_id}.jsonl")) if base.is_dir() else []
    elif PI_SESSIONS_ROOT.is_dir():
        candidates = list(PI_SESSIONS_ROOT.glob(f"*/*_{session_id}.jsonl"))
    else:
        candidates = []
    out = []
    for c in candidates:
        if pi_filename_session_id(c) != session_id:
            continue
        header = pi_read_session_header(c)
        if header is None or header.get("id") != session_id:
            continue
        out.append(c)
    return sorted(out)


def pi_candidate_lines(cwd: Optional[str], session_dir: Optional[str] = None) -> List[str]:
    """Human-readable candidate list for fail-closed diagnostics (never auto-picked)."""
    if session_dir:
        d = Path(session_dir).expanduser()
    elif cwd:
        d = PI_SESSIONS_ROOT / pi_path_key_for_cwd(cwd)
    else:
        return []
    if not d.is_dir():
        return []
    lines = []
    for p in sorted(d.glob("*.jsonl"), key=lambda x: x.stat().st_mtime, reverse=True)[:10]:
        age_min = (time.time() - p.stat().st_mtime) / 60
        sid = pi_filename_session_id(p) or "?"
        lines.append(f"    id={sid}  age={age_min:.1f}m  {p}")
    return lines


def pi_resolve_by_session_id(session_id: str, pane_cwd: Optional[str],
                             session_dir: Optional[str] = None) -> Path:
    """Resolve a session id to exactly one session file, or raise.

    Never considers mtime. Ambiguity (the same id under several project dirs)
    is resolved only by the pane's cwd matching the session header cwd.
    """
    matches = pi_find_sessions_by_id(session_id, session_dir)
    if not matches:
        where = f"session dir {session_dir}" if session_dir else f"sessions root {PI_SESSIONS_ROOT}"
        raise ValueError(
            f"no session file found for session id '{session_id}' under {where}\n"
            f"  pi persists a session on its first assistant reply — a freshly launched worker\n"
            f"  has no JSONL yet. Wait for the worker's first turn, then retry.\n"
            f"  Also verify the id matches the one given to `pi --session-id` at launch\n"
            f"  (or the uuid in `pi --session <uuid>` for a resumed worker)."
        )
    if len(matches) > 1:
        if pane_cwd:
            pane_real = os.path.realpath(pane_cwd)
            cwd_matches = [
                m for m in matches
                if os.path.realpath(str((pi_read_session_header(m) or {}).get("cwd", ""))) == pane_real
            ]
            if len(cwd_matches) == 1:
                return cwd_matches[0]
        listing = "\n".join(f"    {m}" for m in matches)
        raise ValueError(
            f"session id '{session_id}' matches multiple session files:\n{listing}\n"
            f"  pass --path <file> to pick one explicitly (or --session-dir to scope the search)"
        )
    match = matches[0]
    if pane_cwd and not session_dir:
        header_cwd = str((pi_read_session_header(match) or {}).get("cwd", ""))
        if os.path.realpath(header_cwd) != os.path.realpath(pane_cwd):
            raise ValueError(
                f"session '{session_id}' belongs to cwd {header_cwd}, but the tmux pane is in {pane_cwd}\n"
                f"  this usually means the wrong pane target was given, or the worker was launched\n"
                f"  in a different directory. Verify the pane, or pass --path to override deliberately."
            )
    return match


def find_record_bound_to(path: Path, exclude_id: Optional[str] = None) -> Optional[Dict[str, Any]]:
    """Registered worker already bound to this transcript, if any."""
    real = os.path.realpath(str(path))
    for rec in list_records():
        if exclude_id is not None and rec.get("id") == exclude_id:
            continue
        other = (rec.get("persisted") or {}).get("path")
        if other and os.path.realpath(str(other)) == real:
            return rec
    return None


def pi_load_active(path: Path) -> List[Dict[str, Any]]:
    lines = path.read_text(encoding="utf-8").splitlines()
    parsed = []
    nonempty = [(index, line) for index, line in enumerate(lines) if line.strip()]
    for position, (line_index, line) in enumerate(nonempty):
        try:
            parsed.append(json.loads(line))
        except json.JSONDecodeError:
            if position == len(nonempty) - 1:
                # The worker may be in the middle of appending its final JSONL
                # record. Ignore only that incomplete tail; malformed history
                # elsewhere remains a loud error.
                continue
            raise ValueError(f"malformed pi session JSONL at line {line_index + 1}: {path}")
    if not parsed or parsed[0].get("type") != "session":
        raise ValueError(f"not a pi session file: {path}")
    entries = parsed[1:]

    id_map: Dict[str, Dict[str, Any]] = {}
    leaf: Optional[Dict[str, Any]] = None
    for e in entries:
        eid = e.get("id")
        if eid:
            id_map[eid] = e
            leaf = e
    if leaf is None:
        return []
    chain: List[Dict[str, Any]] = []
    seen = set()
    cur: Optional[Dict[str, Any]] = leaf
    while cur is not None:
        eid = cur.get("id")
        if eid in seen:
            break
        seen.add(eid)
        chain.append(cur)
        parent_id = cur.get("parentId")
        cur = id_map.get(parent_id) if parent_id else None
    chain.reverse()
    return chain


def pi_displayable(entries: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    types = {"message", "model_change", "thinking_level_change", "compaction",
             "branch_summary", "session_info", "custom_message", "label"}
    return [e for e in entries if e.get("type") in types]


def pi_stringify(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return str(content)
    parts: List[str] = []
    for block in content:
        if not isinstance(block, dict):
            parts.append(str(block))
            continue
        bt = block.get("type")
        if bt == "text":
            parts.append(block.get("text", ""))
        elif bt == "image":
            parts.append(f"[image:{block.get('mimeType', '?')}]")
        elif bt == "thinking":
            continue
        elif bt == "toolCall":
            parts.append(f"[toolCall:{block.get('name', '?')}]")
        else:
            parts.append(f"[{bt}]")
    return "\n".join(p for p in parts if p)


def pi_preview_args(args: Any, limit: int) -> str:
    if not isinstance(args, dict):
        return single_line(str(args), limit)
    preferred = ["path", "command", "pattern", "oldText", "newText", "content",
                 "file", "filePath", "description", "text", "name"]
    for k in preferred:
        if k in args:
            return f"{k}={single_line(json.dumps(args[k], ensure_ascii=False), limit)}"
    if not args:
        return ""
    k = next(iter(args))
    return f"{k}={single_line(json.dumps(args[k], ensure_ascii=False), limit)}"


def pi_locator_context(entries: List[Dict[str, Any]]) -> Tuple[Dict[str, str], Dict[str, str]]:
    ids = [str(entry.get("id")) for entry in entries if entry.get("id")]
    prefixes = unique_prefixes(ids)
    call_locators: Dict[str, str] = {}
    for entry in entries:
        eid = str(entry.get("id", "?"))
        loc = prefixes.get(eid, eid)
        msg = entry.get("message", {}) if entry.get("type") == "message" else {}
        content = msg.get("content", []) if isinstance(msg.get("content", []), list) else []
        calls = [block for block in content
                 if isinstance(block, dict) and block.get("type") == "toolCall"]
        for number, block in enumerate(calls, 1):
            if block.get("id"):
                call_locators[str(block["id"])] = f"{loc}/tool/{number}"
    return prefixes, call_locators


def pi_format(entry: Dict[str, Any], locator: Optional[str] = None,
              call_locators: Optional[Dict[str, str]] = None) -> Entry:
    etype = entry.get("type")
    eid = str(entry.get("id", "?"))
    loc = locator or eid
    call_locators = call_locators or {}
    ts = fmt_ts(entry.get("timestamp"))
    if etype != "message":
        if etype == "model_change":
            model = f"{entry.get('provider', '?')}/{entry.get('modelId', '?')}"
            return Entry(eid, ts, etype, f"[model] {ts} id={loc} {model}",
                         overview=[OverviewLine(loc, ts, "model", model, limit=OVERVIEW_TOOL_TRUNC)])
        if etype == "compaction":
            before = entry.get("tokensBefore")
            text = f"from={before / 1000:.0f}k tokens" if isinstance(before, (int, float)) else "conversation compacted"
            if entry.get("fromHook"):
                text += " automatically"
            return Entry(eid, ts, etype, f"[compaction] {ts} id={loc} {text}",
                         overview=[OverviewLine(loc, ts, "compaction", text, limit=OVERVIEW_TOOL_TRUNC)])
        if etype == "branch_summary":
            return Entry(eid, ts, etype, f"[branch-summary] {ts} id={loc}",
                         overview=[OverviewLine(loc, ts, "branch-summary", limit=OVERVIEW_TOOL_TRUNC)])
        return Entry(eid, ts, etype, f"[{etype}] {ts} id={loc}",
                     overview=[OverviewLine(loc, ts, str(etype), "", limit=OVERVIEW_TOOL_TRUNC)])

    msg = entry.get("message", {})
    role = msg.get("role", "?")
    if role == "user":
        text = pi_stringify(msg.get("content", ""))
        body = "\n".join("  " + line for line in trunc(text, TEXT_TRUNC).splitlines() or [""])
        return Entry(eid, ts, "user", f"[user] {ts} id={loc}", body,
                     overview=[OverviewLine(loc, ts, "user", text, preserve_tail=True)])
    if role == "assistant":
        content = msg.get("content", [])
        text_parts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
        text = "\n".join(p for p in text_parts if p).strip()
        lines: List[str] = []
        overview: List[OverviewLine] = []
        if text:
            for line in trunc(text, TEXT_TRUNC).splitlines() or [""]:
                lines.append("  " + line)
            overview.append(OverviewLine(loc, ts, "assistant", text, preserve_tail=True))
        thinking_number = 0
        for block in content if isinstance(content, list) else []:
            if not isinstance(block, dict) or block.get("type") != "thinking":
                continue
            for label in reasoning_labels(block.get("thinking")):
                thinking_number += 1
                lines.append(f"  intent: {label}")
                overview.append(OverviewLine(f"{loc}/thinking/{thinking_number}", ts, "intent", label,
                                             limit=OVERVIEW_INTENT_TRUNC, preserve_tail=True))
        tool_number = 0
        for tc in [b for b in content if isinstance(b, dict) and b.get("type") == "toolCall"]:
            tool_number += 1
            preview = pi_preview_args(tc.get("arguments", {}), ARGS_TRUNC)
            suffix = f" {preview}" if preview else ""
            child_loc = f"{loc}/tool/{tool_number}"
            lines.append(f"  tool: {tc.get('name', '?')}{suffix} [{child_loc}]")
            overview.append(OverviewLine(child_loc, ts, "tool",
                                         f"{tc.get('name', '?')} {pi_preview_args(tc.get('arguments', {}), OVERVIEW_TOOL_TRUNC)}",
                                         limit=OVERVIEW_TOOL_TRUNC))
        sr = meaningful_stop_reason(msg.get("stopReason"), has_tool_call=tool_number > 0)
        if sr:
            lines.append(f"  stop: {sr}")
        if not overview:
            overview.append(OverviewLine(loc, ts, "assistant", f"stop={sr}" if sr else "(no visible content)",
                                         limit=OVERVIEW_TOOL_TRUNC))
        return Entry(eid, ts, "assistant", f"[assistant] {ts} id={loc}", "\n".join(lines), overview=overview)
    if role == "toolResult":
        text = pi_stringify(msg.get("content", []))
        is_error = bool(msg.get("isError"))
        err = " ERROR" if is_error else ""
        tool = msg.get("toolName", "?")
        call_ref = call_locators.get(str(msg.get("toolCallId", "")))
        association = f" for={call_ref}" if call_ref else ""
        header = f"[result{err}] {ts} id={loc} tool={tool}{association}"
        body = f"  {single_line(text, RESULT_TRUNC)}" if text else ""
        status = "ERROR " if is_error else ""
        overview_text = f"{tool}{association} {status}{text}"
        return Entry(eid, ts, "tool_result", header, body,
                     overview=[OverviewLine(loc, ts, "result", overview_text,
                                            limit=OVERVIEW_RESULT_TRUNC, preserve_tail=True)])
    if role == "bashExecution":
        out = msg.get("output", "")
        command = msg.get("command", "")
        body_lines = [f"  command: {single_line(command, ARGS_TRUNC)}"]
        if out:
            body_lines.append(f"  output: {single_line(out, RESULT_TRUNC)}")
        ec = msg.get("exitCode")
        if ec is not None:
            body_lines.append(f"  exitCode: {ec}")
        overview = [OverviewLine(f"{loc}/tool/1", ts, "tool", f"bash command={command}",
                                 limit=OVERVIEW_TOOL_TRUNC)]
        overview.append(OverviewLine(loc, ts, "result", f"bash exit={ec} {out}",
                                     limit=OVERVIEW_RESULT_TRUNC, preserve_tail=True))
        return Entry(eid, ts, "bash", f"[bashExecution] {ts} id={loc}", "\n".join(body_lines), overview=overview)
    return Entry(eid, ts, role, f"[{role}] {ts} id={loc}",
                 overview=[OverviewLine(loc, ts, str(role), "", limit=OVERVIEW_TOOL_TRUNC)])


class PiAdapter:
    kind = "pi"

    @staticmethod
    def session_path(rec: Dict[str, Any]) -> Path:
        # The registered path is the worker's identity. If the file is gone,
        # fail loudly — re-resolving "some other file" here (e.g. by recency)
        # would silently attach another agent's transcript.
        path = rec.get("persisted", {}).get("path")
        if path and Path(path).exists():
            return Path(path)
        sid = rec.get("extra", {}).get("session_id")
        raise ValueError(
            f"registered session file is gone: {path or '(none recorded)'}\n"
            f"  worker '{rec.get('id')}'"
            + (f" was bound to session id '{sid}'" if sid else "")
            + " — if the session still exists, re-register (or pass --path); "
            "superv never re-binds by recency."
        )

    @classmethod
    def read_persisted(cls, rec: Dict[str, Any], count: Optional[int] = None,
                       use_cursor: bool = True) -> Tuple[List[Entry], Dict[str, Any]]:
        path = cls.session_path(rec)
        active = pi_displayable(pi_load_active(path))
        cursor = load_cursor(rec["id"]) if use_cursor else None
        if cursor and cursor.get("session_path") == str(path):
            last_id = cursor.get("last_entry_id")
            ids = [e.get("id") for e in active]
            try:
                idx = ids.index(last_id)
                unread = active[idx + 1:]
                window = unread[:count] if count is not None else unread
            except ValueError:
                raise ValueError("cursor entry not on active branch — use 'watch --reset' to rebootstrap")
        else:
            if cursor is None and len(active) > ESTABLISHED_THRESHOLD and count is None:
                raise ValueError(f"established session ({len(active)} entries) requires a cursor — use 'watch --reset' or 'watch --count N' to bootstrap")
            window = active[-(count or RECENT_COUNT_DEFAULT):]

        prefix_by_id, call_locators = pi_locator_context(active)
        rendered = [pi_format(e, prefix_by_id.get(str(e.get("id")), str(e.get("id", "?"))), call_locators)
                    for e in window]
        for formatted, raw in zip(rendered, window):
            formatted.cursor_after = {"session_path": str(path), "last_entry_id": raw.get("id")}
        new_cursor = {
            "session_path": str(path),
            "last_entry_id": window[-1].get("id") if window else (active[-1].get("id") if active else None),
        }
        return rendered, new_cursor

    @classmethod
    def detail(cls, rec: Dict[str, Any], target: str) -> str:
        path = cls.session_path(rec)
        entries = pi_load_active(path)
        parent_target = target.split("/", 1)[0]
        ids = [str(entry.get("id")) for entry in entries if entry.get("id")]
        prefix_by_id, call_locators = pi_locator_context(entries)
        parent_id = (resolve_unique_prefix(ids, parent_target, "pi entry id")
                     if "/" in target or any(value.startswith(parent_target) for value in ids) else None)
        for entry in entries:
            eid = str(entry.get("id", "?"))
            if entry.get("type") == "message":
                msg = entry.get("message", {})
                content = msg.get("content", []) if isinstance(msg.get("content", []), list) else []
                if parent_id == eid and "/" in target:
                    suffix = target[len(parent_target):]
                    if msg.get("role") == "bashExecution":
                        if suffix != "/tool/1":
                            raise ValueError(f"pi child locator not found: {target}")
                        command, cut = clip_overview(msg.get("command", ""), DETAIL_COMPONENT_TRUNC, preserve_tail=True)
                        return f"[tool] id={target} name=bash\n  command: {command}" + ("\n  (command shortened)" if cut else "")
                    match = re.fullmatch(r"/(tool|thinking)/(\d+)", suffix)
                    if not match:
                        raise ValueError(f"invalid pi child locator: {target}")
                    kind, number_text = match.groups()
                    block_type = "toolCall" if kind == "tool" else "thinking"
                    blocks = [block for block in content if isinstance(block, dict) and block.get("type") == block_type]
                    number = int(number_text)
                    if number < 1 or number > len(blocks):
                        raise ValueError(f"pi child locator not found: {target}")
                    block = blocks[number - 1]
                    if kind == "thinking":
                        return f"[intent] id={target}\n  " + "\n  ".join(reasoning_labels(block.get("thinking")))
                    args = json.dumps(block.get("arguments", {}), ensure_ascii=False)
                    shown, cut = clip_overview(args, DETAIL_COMPONENT_TRUNC, preserve_tail=True)
                    return f"[toolCall] id={target} name={block.get('name', '?')}\n  arguments: {shown}" + ("\n  (arguments shortened)" if cut else "")
                if msg.get("role") == "toolResult" and msg.get("toolCallId") == target:
                    return pi_format(entry).render()
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "toolCall" and block.get("id") == target:
                        args = json.dumps(block.get("arguments", {}), ensure_ascii=False)
                        shown, cut = clip_overview(args, DETAIL_COMPONENT_TRUNC, preserve_tail=True)
                        return f"[toolCall] id={target} name={block.get('name', '?')}\n  arguments: {shown}" + ("\n  (arguments shortened)" if cut else "")
            if eid == target or (parent_id == eid and "/" not in target):
                if entry.get("type") == "compaction":
                    summary, cut = clip_overview(entry.get("summary", ""), TEXT_TRUNC, preserve_tail=True)
                    rendered = pi_format(entry, prefix_by_id.get(eid, eid), call_locators).render()
                    return f"{rendered}\n  summary: {summary}" + ("\n  (summary shortened)" if cut else "")
                return pi_format(entry, prefix_by_id.get(eid, eid), call_locators).render()
        raise ValueError(f"id not found on active branch: {target}")

    @classmethod
    def raw_detail(cls, rec: Dict[str, Any], target: str) -> Any:
        entries = pi_load_active(cls.session_path(rec))
        ids = [str(entry.get("id")) for entry in entries if entry.get("id")]
        parent_target = target.split("/", 1)[0]
        parent_id = (resolve_unique_prefix(ids, parent_target, "pi entry id")
                     if "/" in target or any(value.startswith(parent_target) for value in ids) else None)
        for entry in entries:
            eid = str(entry.get("id", "?"))
            if parent_id == eid and "/" in target:
                suffix = target[len(parent_target):]
                match = re.fullmatch(r"/(tool|thinking|result)/(\d+)", suffix)
                if not match:
                    raise ValueError(f"invalid pi child locator: {target}")
                kind, number_text = match.groups()
                msg = entry.get("message", {}) if entry.get("type") == "message" else {}
                if msg.get("role") == "bashExecution":
                    if kind == "tool" and number_text == "1":
                        return {"type": "toolCall", "name": "bash", "command": msg.get("command", "")}
                    if kind == "result" and number_text == "1":
                        return {"type": "toolResult", "output": msg.get("output", ""),
                                "exitCode": msg.get("exitCode")}
                    raise ValueError(f"pi child locator not found: {target}")
                content = msg.get("content", []) if isinstance(msg.get("content", []), list) else []
                block_type = {"tool": "toolCall", "thinking": "thinking", "result": "toolResult"}[kind]
                blocks = [block for block in content
                          if isinstance(block, dict) and block.get("type") == block_type]
                number = int(number_text)
                if number < 1 or number > len(blocks):
                    raise ValueError(f"pi child locator not found: {target}")
                return blocks[number - 1]
            if eid == parent_id and "/" not in target:
                return entry
            if entry.get("type") == "message":
                msg = entry.get("message", {})
                content = msg.get("content", []) if isinstance(msg.get("content", []), list) else []
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "toolCall" and block.get("id") == target:
                        return block
                if msg.get("role") == "toolResult" and msg.get("toolCallId") == target:
                    return entry
        raise ValueError(f"id not found on active branch: {target}")

    @classmethod
    def read_live(cls, rec: Dict[str, Any]) -> str:
        target = rec.get("live", {}).get("target")
        if not target:
            return "(no tmux target registered)"
        return tmux_capture(target, lines=120)

    @classmethod
    def send(cls, rec: Dict[str, Any], text: str) -> None:
        target = rec.get("send", {}).get("target") or rec.get("live", {}).get("target")
        if not target:
            raise ValueError("pi: no tmux target registered for send")
        tmux_send_keys(target, text)

    @classmethod
    def turn_state(cls, rec: Dict[str, Any]) -> str:
        try:
            return pi_turn_state_from_entries(pi_load_active(cls.session_path(rec)))
        except Exception:
            return "unknown"

    @classmethod
    def status_signals(cls, rec: Dict[str, Any]) -> Dict[str, Any]:
        try:
            path = cls.session_path(rec)
            age = time.time() - path.stat().st_mtime
            active = pi_load_active(path)
            visible = pi_displayable(active)
        except Exception:
            return {
                "turn": "unknown", "persisted_age_s": float("inf"),
                "context_input_tokens": None, "context_window_tokens": None,
                "unread_count": None, "latest_marker": None,
            }
        ids = [entry.get("id") for entry in visible]
        unread = unread_after_id(load_cursor(rec["id"]), identity_key="session_path",
                                 identity_value=str(path), last_key="last_entry_id", ids=ids)
        recent = [pi_format(entry) for entry in visible[-50:]]
        return {
            "turn": pi_turn_state_from_entries(active),
            "persisted_age_s": age,
            "context_input_tokens": pi_last_context_tokens_from_entries(active),
            "context_window_tokens": pi_context_window_tokens_from_entries(active),
            "unread_count": unread,
            "latest_marker": latest_supervisory_marker(recent),
        }


def pi_turn_state_from_entries(entries: List[Dict[str, Any]]) -> str:
    for entry in reversed(entries):
        if entry.get("type") != "message":
            continue
        msg = entry.get("message", {})
        role = msg.get("role")
        if role == "assistant":
            content = msg.get("content", [])
            has_tool_call = any(
                isinstance(block, dict) and block.get("type") == "toolCall"
                for block in content if isinstance(content, list)
            )
            stop = str(msg.get("stopReason") or msg.get("stop_reason") or "").lower()
            return "busy" if has_tool_call or stop in {"tooluse", "tool_use", "tool-use"} else "idle"
        if role in {"user", "toolResult", "bashExecution"}:
            return "busy"
        return "unknown"
    return "unknown"


def _find_model_context_window(value: Any, provider: str, model: str,
                               inherited_provider: Optional[str] = None) -> Optional[int]:
    if isinstance(value, dict):
        current_provider = str(value.get("provider") or value.get("providerId") or inherited_provider or "")
        current_model = str(value.get("id") or value.get("model") or value.get("modelId") or "")
        if current_model == model and (not provider or not current_provider or current_provider == provider):
            candidate = value.get("contextWindow") or value.get("context_window")
            try:
                parsed = int(candidate)
                if parsed > 0:
                    return parsed
            except (TypeError, ValueError):
                pass
        for key, child in value.items():
            child_provider = current_provider
            if key == provider or (inherited_provider is None and key not in {"providers", "models", "modelOverrides"}):
                child_provider = str(key)
            found = _find_model_context_window(child, provider, model, child_provider)
            if found:
                return found
    elif isinstance(value, list):
        for child in value:
            found = _find_model_context_window(child, provider, model, inherited_provider)
            if found:
                return found
    return None


def pi_context_window_tokens_from_entries(entries: List[Dict[str, Any]]) -> Optional[int]:
    provider = ""
    model = ""
    for entry in reversed(entries):
        if entry.get("type") == "message":
            msg = entry.get("message", {})
            if msg.get("role") == "assistant" and (msg.get("model") or msg.get("modelId")):
                provider = str(msg.get("provider") or "")
                model = str(msg.get("model") or msg.get("modelId"))
                break
        if entry.get("type") == "model_change" and entry.get("modelId"):
            provider = str(entry.get("provider") or "")
            model = str(entry.get("modelId"))
            break
    if not model:
        return None
    for models_path in (PI_MODELS_PATH, PI_MODELS_STORE_PATH):
        try:
            data = json.loads(models_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError, ValueError):
            continue
        found = _find_model_context_window(data, provider, model)
        if found:
            return found
    return None


def pi_last_context_tokens_from_entries(entries: List[Dict[str, Any]]) -> Optional[int]:
    """Pi prompt tokens are input plus cacheRead; cacheRead is additive."""
    for entry in reversed(entries):
        if entry.get("type") == "compaction":
            return None
        if entry.get("type") != "message":
            continue
        msg = entry.get("message", {})
        if msg.get("role") != "assistant":
            continue
        usage = msg.get("usage")
        if not isinstance(usage, dict):
            continue
        try:
            input_t = int(usage.get("input") or usage.get("input_tokens") or 0)
            cache_read = int(usage.get("cacheRead") or usage.get("cache_read_input_tokens") or 0)
        except (TypeError, ValueError):
            continue
        total = input_t + cache_read
        if total > 0:
            return total
    return None


# -- adapter: claude ----------------------------------------------------------

def claude_path_key_for_cwd(cwd: str) -> str:
    trimmed = cwd.strip("/")
    return f"-{trimmed.replace('/', '-')}"


def claude_resolve_session(cwd: Optional[str], hint: Optional[str]) -> Path:
    if hint:
        p = Path(hint).expanduser()
        if p.exists():
            return p
        if CLAUDE_PROJECTS_ROOT.exists():
            matches = [c for c in CLAUDE_PROJECTS_ROOT.rglob("*.jsonl") if hint in c.name]
            if len(matches) == 1:
                return matches[0]
            if len(matches) > 1:
                raise ValueError(f"ambiguous claude session hint: {hint}")
        raise ValueError(f"claude session not found: {hint}")
    if not cwd:
        raise ValueError("claude: need cwd to resolve session")
    d = CLAUDE_PROJECTS_ROOT / claude_path_key_for_cwd(cwd)
    if not d.exists():
        raise ValueError(f"claude: no projects dir for cwd {cwd}")
    files = sorted(d.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not files:
        raise ValueError(f"claude: no jsonl files in {d}")
    return files[0]


def claude_load_entries(path: Path) -> List[Dict[str, Any]]:
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            out.append(json.loads(line))
        except Exception:
            continue
    return out


def claude_visible(entries: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []
    for e in entries:
        t = e.get("type")
        if t in {"user", "assistant"}:
            out.append(e)
        elif t == "system" and e.get("subtype") == "compact_boundary":
            out.append(e)
    return out


def claude_content_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return str(content)
    parts: List[str] = []
    for block in content:
        if not isinstance(block, dict):
            parts.append(str(block))
            continue
        bt = block.get("type")
        if bt == "text":
            parts.append(block.get("text", ""))
        elif bt == "thinking":
            continue
        elif bt == "tool_use":
            parts.append(f"[tool_use:{block.get('name', '?')}]")
        elif bt == "tool_result":
            v = block.get("content", "")
            parts.append(v if isinstance(v, str) else str(v))
        else:
            parts.append(f"[{bt}]")
    return "\n".join(p for p in parts if p)


def claude_preview_args(args: Any, limit: int) -> str:
    if not isinstance(args, dict):
        return single_line(str(args), limit)
    preferred = ["command", "file_path", "path", "pattern", "query", "url", "prompt", "content", "description"]
    for k in preferred:
        if k in args:
            return f"{k}={single_line(json.dumps(args[k], ensure_ascii=False), limit)}"
    if not args:
        return ""
    k = next(iter(args))
    return f"{k}={single_line(json.dumps(args[k], ensure_ascii=False), limit)}"


def claude_locator_context(entries: List[Dict[str, Any]]) -> Tuple[Dict[str, str], Dict[str, str]]:
    ids = [str(entry.get("uuid")) for entry in entries if entry.get("uuid")]
    prefixes = unique_prefixes(ids)
    call_locators: Dict[str, str] = {}
    for entry in entries:
        uuid = str(entry.get("uuid", "?"))
        loc = prefixes.get(uuid, uuid)
        msg = entry.get("message", {})
        content = msg.get("content", []) if isinstance(msg.get("content", []), list) else []
        calls = [block for block in content
                 if isinstance(block, dict) and block.get("type") == "tool_use"]
        for number, block in enumerate(calls, 1):
            if block.get("id"):
                call_locators[str(block["id"])] = f"{loc}/tool/{number}"
    return prefixes, call_locators


def claude_format(entry: Dict[str, Any], locator: Optional[str] = None,
                  call_locators: Optional[Dict[str, str]] = None) -> Entry:
    etype = entry.get("type")
    uuid = str(entry.get("uuid", "?"))
    loc = locator or uuid
    call_locators = call_locators or {}
    ts = fmt_ts(entry.get("timestamp"))
    if etype == "assistant":
        msg = entry.get("message", {})
        text_parts: List[str] = []
        tool_lines: List[str] = []
        overview: List[OverviewLine] = []
        thinking_number = 0
        tool_number = 0
        for block in msg.get("content", []):
            if not isinstance(block, dict):
                continue
            bt = block.get("type")
            if bt == "text":
                text_parts.append(block.get("text", ""))
            elif bt == "thinking":
                for label in reasoning_labels(block.get("thinking")):
                    thinking_number += 1
                    tool_lines.append(f"  intent: {label}")
                    overview.append(OverviewLine(f"{loc}/thinking/{thinking_number}", ts, "intent", label,
                                                 limit=OVERVIEW_INTENT_TRUNC, preserve_tail=True))
            elif bt == "tool_use":
                tool_number += 1
                preview = claude_preview_args(block.get("input", {}), ARGS_TRUNC)
                suffix = f" {preview}" if preview else ""
                child_loc = f"{loc}/tool/{tool_number}"
                tool_lines.append(f"  tool: {block.get('name', '?')}{suffix} [{child_loc}]")
                overview.append(OverviewLine(child_loc, ts, "tool",
                                             f"{block.get('name', '?')} {claude_preview_args(block.get('input', {}), OVERVIEW_TOOL_TRUNC)}",
                                             limit=OVERVIEW_TOOL_TRUNC))
        text = "\n".join(p for p in text_parts if p).strip()
        body_lines = []
        if text:
            for line in trunc(text, TEXT_TRUNC).splitlines() or [""]:
                body_lines.append("  " + line)
            overview.insert(0, OverviewLine(loc, ts, "assistant", text, preserve_tail=True))
        body_lines.extend(tool_lines)
        sr = meaningful_stop_reason(msg.get("stop_reason"), has_tool_call=tool_number > 0)
        if sr:
            body_lines.append(f"  stop: {sr}")
        if not overview:
            overview.append(OverviewLine(loc, ts, "assistant", f"stop={sr}" if sr else "(no visible content)",
                                         limit=OVERVIEW_TOOL_TRUNC))
        return Entry(uuid, ts, "assistant", f"[assistant] {ts} id={loc}", "\n".join(body_lines), overview=overview)
    if etype == "user":
        msg = entry.get("message", {})
        content = msg.get("content", "")
        if isinstance(content, list):
            tool_blocks = [b for b in content if isinstance(b, dict) and b.get("type") == "tool_result"]
            if tool_blocks:
                lines = []
                overview = []
                for number, block in enumerate(tool_blocks, 1):
                    tool_id = str(block.get("tool_use_id", "?"))
                    text = block.get("content", "")
                    if not isinstance(text, str):
                        text = claude_content_text(text)
                    is_error = bool(block.get("is_error"))
                    err = " ERROR" if is_error else ""
                    result_loc = f"{loc}/result/{number}"
                    call_ref = call_locators.get(tool_id)
                    association = f" for={call_ref}" if call_ref else ""
                    lines.append(f"[result{err}] {ts} id={result_loc}{association}")
                    lines.append(f"  {single_line(text, RESULT_TRUNC)}")
                    status = "ERROR " if is_error else ""
                    overview.append(OverviewLine(result_loc, ts, "result",
                                                 f"{association.strip()} {status}{text}".strip(),
                                                 limit=OVERVIEW_RESULT_TRUNC, preserve_tail=True))
                return Entry(uuid, ts, "tool_result", "\n".join(lines), overview=overview)
        text = claude_content_text(content)
        body = "\n".join("  " + l for l in trunc(text, TEXT_TRUNC).splitlines() or [""])
        return Entry(uuid, ts, "user", f"[user] {ts} id={loc}", body,
                     overview=[OverviewLine(loc, ts, "user", text, preserve_tail=True)])
    if etype == "system" and entry.get("subtype") == "compact_boundary":
        meta = entry.get("compactMetadata") or {}
        before = meta.get("preTokens")
        after = meta.get("postTokens")
        text = "conversation compacted"
        if isinstance(before, (int, float)):
            text = f"from={before / 1000:.0f}k tokens"
            if isinstance(after, (int, float)):
                text += f" to={after / 1000:.0f}k"
        return Entry(uuid, ts, "compaction", f"[compaction] {ts} id={loc} {text}",
                     overview=[OverviewLine(loc, ts, "compaction", text, limit=OVERVIEW_TOOL_TRUNC)])
    return Entry(uuid, ts, etype or "other", f"[{etype}] {ts} id={loc}",
                 overview=[OverviewLine(loc, ts, etype or "other", "", limit=OVERVIEW_TOOL_TRUNC)])


class ClaudeAdapter:
    kind = "claude"

    @staticmethod
    def session_path(rec: Dict[str, Any]) -> Path:
        path = rec.get("persisted", {}).get("path")
        if path and Path(path).exists():
            return Path(path)
        # Stored transcript path is gone. Claude agents launch in the
        # worktrees' PARENT folder, which several agents share, so the
        # cwd-keyed projects dir holds other agents' transcripts too —
        # "newest jsonl for this cwd" would happily grab someone else's.
        # Re-resolve only by the stored session id; otherwise fail loudly.
        sid = rec.get("extra", {}).get("session_id")
        if not sid:
            raise ValueError(
                f"claude: stored session file is missing ({path or 'no path recorded'}) and the "
                f"record has no extra.session_id to re-resolve it safely.\n"
                f"  Refusing to guess by recency (shared cwd => could bind another agent's transcript).\n"
                f"  Fix persisted.path, or re-register with an explicit --path."
            )
        return claude_resolve_session(None, sid)

    @classmethod
    def read_persisted(cls, rec, count=None, use_cursor=True):
        path = cls.session_path(rec)
        entries = claude_visible(claude_load_entries(path))
        cursor = load_cursor(rec["id"]) if use_cursor else None
        if cursor and cursor.get("session_path") == str(path):
            last_uuid = cursor.get("last_entry_id")
            ids = [e.get("uuid") for e in entries]
            try:
                idx = ids.index(last_uuid)
                unread = entries[idx + 1:]
                window = unread[:count] if count is not None else unread
            except ValueError:
                raise ValueError("claude cursor not in session — use 'watch --reset' to rebootstrap")
        else:
            if cursor is None and len(entries) > ESTABLISHED_THRESHOLD and count is None:
                raise ValueError(f"established session ({len(entries)} entries) requires a cursor")
            window = entries[-(count or RECENT_COUNT_DEFAULT):]
        prefix_by_id, call_locators = claude_locator_context(entries)
        rendered = [claude_format(e, prefix_by_id.get(str(e.get("uuid")), str(e.get("uuid", "?"))), call_locators)
                    for e in window]
        for formatted, raw in zip(rendered, window):
            formatted.cursor_after = {"session_path": str(path), "last_entry_id": raw.get("uuid")}
        new_cursor = {
            "session_path": str(path),
            "last_entry_id": window[-1].get("uuid") if window else (entries[-1].get("uuid") if entries else None),
        }
        return rendered, new_cursor

    @classmethod
    def detail(cls, rec, target):
        path = cls.session_path(rec)
        entries = claude_visible(claude_load_entries(path))
        ids = [str(entry.get("uuid")) for entry in entries if entry.get("uuid")]
        parent_target = target.split("/", 1)[0]
        parent_id = None
        if "/" in target or any(value.startswith(parent_target) for value in ids):
            parent_id = resolve_unique_prefix(ids, parent_target, "claude entry id")
        prefix_by_id, call_locators = claude_locator_context(entries)
        for entry in entries:
            uuid = str(entry.get("uuid", "?"))
            msg = entry.get("message", {})
            content = msg.get("content")
            blocks = content if isinstance(content, list) else []
            if parent_id == uuid and "/" in target:
                suffix = target[len(parent_target):]
                match = re.fullmatch(r"/(tool|thinking|result)/(\d+)", suffix)
                if not match:
                    raise ValueError(f"invalid claude child locator: {target}")
                kind, number_text = match.groups()
                block_type = {"tool": "tool_use", "thinking": "thinking", "result": "tool_result"}[kind]
                selected = [block for block in blocks if isinstance(block, dict) and block.get("type") == block_type]
                number = int(number_text)
                if number < 1 or number > len(selected):
                    raise ValueError(f"claude child locator not found: {target}")
                block = selected[number - 1]
                if kind == "thinking":
                    return f"[intent] id={target}\n  " + "\n  ".join(reasoning_labels(block.get("thinking")))
                value = block.get("input", {}) if kind == "tool" else block.get("content", "")
                text = json.dumps(value, ensure_ascii=False) if not isinstance(value, str) else value
                shown, cut = clip_overview(text, DETAIL_COMPONENT_TRUNC, preserve_tail=True)
                return f"[{kind}] id={target}\n  {shown}" + (f"\n  ({kind} content shortened)" if cut else "")
            if uuid == parent_id and "/" not in target:
                return claude_format(entry, prefix_by_id.get(uuid, uuid), call_locators).render()
            for block in blocks:
                if not isinstance(block, dict):
                    continue
                if block.get("type") == "tool_use" and block.get("id") == target:
                    value = json.dumps(block.get("input", {}), ensure_ascii=False)
                    shown, cut = clip_overview(value, DETAIL_COMPONENT_TRUNC, preserve_tail=True)
                    return f"[tool] id={target} name={block.get('name', '?')}\n  input: {shown}" + ("\n  (input shortened)" if cut else "")
                if block.get("type") == "tool_result" and block.get("tool_use_id") == target:
                    value = block.get("content", "")
                    text = value if isinstance(value, str) else claude_content_text(value)
                    shown, cut = clip_overview(text, DETAIL_COMPONENT_TRUNC, preserve_tail=True)
                    return f"[result] call={target}\n  {shown}" + ("\n  (result shortened)" if cut else "")
        raise ValueError(f"id not found: {target}")

    @classmethod
    def raw_detail(cls, rec, target):
        entries = claude_visible(claude_load_entries(cls.session_path(rec)))
        ids = [str(entry.get("uuid")) for entry in entries if entry.get("uuid")]
        parent_target = target.split("/", 1)[0]
        parent_id = (resolve_unique_prefix(ids, parent_target, "claude entry id")
                     if "/" in target or any(value.startswith(parent_target) for value in ids) else None)
        for entry in entries:
            entry_id = str(entry.get("uuid", "?"))
            msg = entry.get("message", {})
            content = msg.get("content")
            blocks = content if isinstance(content, list) else []
            if parent_id == entry_id and "/" in target:
                suffix = target[len(parent_target):]
                match = re.fullmatch(r"/(tool|thinking|result)/(\d+)", suffix)
                if not match:
                    raise ValueError(f"invalid claude child locator: {target}")
                kind, number_text = match.groups()
                block_type = {"tool": "tool_use", "thinking": "thinking", "result": "tool_result"}[kind]
                selected = [block for block in blocks
                            if isinstance(block, dict) and block.get("type") == block_type]
                number = int(number_text)
                if number < 1 or number > len(selected):
                    raise ValueError(f"claude child locator not found: {target}")
                return selected[number - 1]
            if entry_id == parent_id and "/" not in target:
                return entry
            for block in blocks:
                if not isinstance(block, dict):
                    continue
                if block.get("type") == "tool_use" and block.get("id") == target:
                    return block
                if block.get("type") == "tool_result" and block.get("tool_use_id") == target:
                    return block
        raise ValueError(f"id not found: {target}")

    @classmethod
    def read_live(cls, rec):
        target = rec.get("live", {}).get("target")
        if not target:
            return "(no tmux target registered — claude is being watched via JSONL only)"
        return tmux_capture(target, lines=120)

    @classmethod
    def send(cls, rec, text):
        target = rec.get("send", {}).get("target") or rec.get("live", {}).get("target")
        if not target:
            raise ValueError("claude: no tmux target registered for send")
        tmux_send_keys(target, text)

    @classmethod
    def turn_state(cls, rec) -> str:
        try:
            return claude_turn_state_from_entries(claude_visible(claude_load_entries(cls.session_path(rec))))
        except Exception:
            return "unknown"

    @classmethod
    def status_signals(cls, rec):
        try:
            path = cls.session_path(rec)
            age = time.time() - path.stat().st_mtime
            visible = claude_visible(claude_load_entries(path))
        except Exception:
            return {
                "turn": "unknown", "persisted_age_s": float("inf"),
                "context_input_tokens": None, "unread_count": None, "latest_marker": None,
            }
        ids = [entry.get("uuid") for entry in visible]
        unread = unread_after_id(load_cursor(rec["id"]), identity_key="session_path",
                                 identity_value=str(path), last_key="last_entry_id", ids=ids)
        recent = [claude_format(entry) for entry in visible[-50:]]
        return {
            "turn": claude_turn_state_from_entries(visible),
            "persisted_age_s": age,
            "context_input_tokens": claude_last_context_tokens_from_entries(visible),
            "unread_count": unread,
            "latest_marker": latest_supervisory_marker(recent),
        }


def claude_turn_state_from_entries(entries: List[Dict[str, Any]]) -> str:
    for last in reversed(entries):
        etype = last.get("type")
        if etype == "system" and last.get("subtype") == "compact_boundary":
            continue
        msg = last.get("message", {})
        break
    else:
        return "unknown"
    if etype == "assistant":
        content = msg.get("content", [])
        has_tool_use = any(
            isinstance(block, dict) and block.get("type") == "tool_use"
            for block in content if isinstance(content, list)
        )
        stop = str(msg.get("stop_reason") or msg.get("stopReason") or "").lower()
        return "busy" if has_tool_use or stop in {"tool_use", "tooluse", "tool-use"} else "idle"
    if etype == "user":
        return "busy"
    return "unknown"


def claude_last_context_tokens_from_entries(entries: List[Dict[str, Any]]) -> Optional[int]:
    """Claude prompt tokens sum input, cache-read input, and cache-creation input."""
    for obj in reversed(entries):
        if obj.get("type") == "system" and obj.get("subtype") == "compact_boundary":
            return None
        usage = (obj.get("message") or {}).get("usage")
        if not isinstance(usage, dict):
            continue
        try:
            input_t = int(usage.get("input_tokens") or 0)
            cache_read = int(usage.get("cache_read_input_tokens") or 0)
            cache_create = int(usage.get("cache_creation_input_tokens") or 0)
        except (TypeError, ValueError):
            continue
        total = input_t + cache_read + cache_create
        if total > 0:
            return total
    return None


# -- adapter: codex -----------------------------------------------------------

def codex_resolve_session(cwd: Optional[str], session_id_hint: Optional[str]) -> Path:
    if session_id_hint:
        for p in sorted(CODEX_SESSIONS_ROOT.rglob("*.jsonl"), key=lambda x: x.stat().st_mtime, reverse=True):
            if session_id_hint in p.name:
                return p
        raise ValueError(f"codex session not found: {session_id_hint}")
    if not cwd:
        raise ValueError("codex: need cwd to resolve session")
    if not CODEX_SESSIONS_ROOT.exists():
        raise ValueError("codex: no sessions root")
    candidates = sorted(CODEX_SESSIONS_ROOT.rglob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    for p in candidates[:50]:
        try:
            with p.open("r", encoding="utf-8") as f:
                first = f.readline()
                if not first:
                    continue
                meta = json.loads(first)
                if meta.get("type") == "session_meta":
                    payload = meta.get("payload", {})
                    if os.path.realpath(payload.get("cwd", "")) == os.path.realpath(cwd):
                        return p
        except Exception:
            continue
    raise ValueError(f"codex: no recent session matching cwd {cwd}")


def codex_load_entries(path: Path) -> List[Dict[str, Any]]:
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            out.append(json.loads(line))
        except Exception:
            continue
    return out


def codex_reasoning_text(payload: Dict[str, Any]) -> str:
    parts = []
    summary = payload.get("summary")
    for item in summary if isinstance(summary, list) else []:
        if isinstance(item, str):
            parts.append(item)
        elif isinstance(item, dict):
            value = item.get("text") or item.get("summary_text")
            if value:
                parts.append(str(value))
    return "\n\n".join(parts)


def codex_is_call_type(ptype: Any) -> bool:
    value = str(ptype or "")
    return value.endswith("_call") or value in {"function_call", "web_search_call", "local_shell_call"}


def codex_is_output_type(ptype: Any) -> bool:
    value = str(ptype or "")
    return value.endswith("_call_output") or value in {"function_call_output"}


def codex_visible_indexed(entries: List[Dict[str, Any]], *, legacy: bool = False) -> List[Tuple[int, Dict[str, Any]]]:
    """Deduplicated supervisor-relevant Codex entries with stable raw indices."""
    out: List[Tuple[int, Dict[str, Any]]] = []
    for raw_index, e in enumerate(entries):
        t = e.get("type")
        payload = e.get("payload", {})
        ptype = payload.get("type")
        if t in {"session_meta", "turn_context"}:
            continue
        if legacy:
            if t == "event_msg" and ptype in {"task_started", "task_complete"}:
                out.append((raw_index, e))
            elif t == "response_item" and ptype in {"message", "function_call", "function_call_output"}:
                if ptype != "message" or payload.get("role") != "developer":
                    out.append((raw_index, e))
            continue
        if t == "event_msg":
            # user_message/agent_message duplicate response_item.message.
            if ptype in {"task_started", "task_complete", "context_compacted"}:
                out.append((raw_index, e))
        elif t == "response_item":
            if ptype == "message":
                if payload.get("role") != "developer":
                    out.append((raw_index, e))
            elif codex_is_call_type(ptype) or codex_is_output_type(ptype):
                out.append((raw_index, e))
            elif ptype == "reasoning" and codex_reasoning_text(payload):
                out.append((raw_index, e))
        elif t == "compacted":
            out.append((raw_index, e))
    return out


def codex_visible(entries: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    return [entry for _, entry in codex_visible_indexed(entries)]


def codex_format(entry: Dict[str, Any], idx: int) -> Entry:
    ts = fmt_ts(entry.get("timestamp"))
    eid = f"codex-r{idx}"
    payload = entry.get("payload", {})
    ptype = payload.get("type", "?")

    if entry.get("type") == "event_msg":
        if ptype == "task_started":
            text = f"turn={payload.get('turn_id', '?')}"
            return Entry(eid, ts, "system", f"[task_started] {ts} id={eid} {text}",
                         overview=[OverviewLine(eid, ts, "task-started", text, limit=OVERVIEW_TOOL_TRUNC)])
        if ptype == "task_complete":
            return Entry(eid, ts, "system", f"[task_complete] {ts} id={eid}",
                         overview=[OverviewLine(eid, ts, "task-complete", "", limit=OVERVIEW_TOOL_TRUNC)])
        if ptype == "context_compacted":
            return Entry(eid, ts, "compaction", f"[compaction] {ts} id={eid}",
                         overview=[OverviewLine(eid, ts, "compaction", "conversation compacted",
                                                limit=OVERVIEW_TOOL_TRUNC)])

    if entry.get("type") == "compacted":
        return Entry(eid, ts, "compaction", f"[compaction] {ts} id={eid}",
                     overview=[OverviewLine(eid, ts, "compaction", "conversation compacted",
                                            limit=OVERVIEW_TOOL_TRUNC)])

    if entry.get("type") == "response_item":
        if ptype == "message":
            role = payload.get("role", "?")
            content = payload.get("content", [])
            text_parts: List[str] = []
            for block in content if isinstance(content, list) else []:
                if not isinstance(block, dict):
                    continue
                bt = block.get("type")
                if bt in ("input_text", "output_text", "text"):
                    text_parts.append(block.get("text", ""))
            text = "\n".join(p for p in text_parts if p).strip()
            body = "\n".join("    " + l for l in trunc(text, TEXT_TRUNC).splitlines() or [""])
            label = "user" if role == "user" else ("assistant" if role == "assistant" else role)
            return Entry(eid, ts, label, f"[{label}] {ts} id={eid}", "  text:\n" + body,
                         overview=[OverviewLine(eid, ts, label, text, preserve_tail=True)])
        if ptype == "reasoning":
            text = codex_reasoning_text(payload)
            body = "\n".join(f"  intent: {label}" for label in reasoning_labels(text))
            return Entry(eid, ts, "intent", f"[intent] {ts} id={eid}", body,
                         overview=[OverviewLine(eid, ts, "intent", label,
                                                limit=OVERVIEW_INTENT_TRUNC, preserve_tail=True)
                                   for label in reasoning_labels(text)])
        if codex_is_call_type(ptype):
            name = payload.get("name") or str(ptype).removesuffix("_call") or "?"
            value = payload.get("arguments")
            if value is None:
                value = payload.get("input")
            if value is None:
                value = payload.get("command")
            if value is None:
                value = payload.get("action", "")
            raw = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
            preview = single_line(raw, ARGS_TRUNC)
            call_id = payload.get("call_id", payload.get("id", "?"))
            return Entry(eid, ts, "tool_call", f"[{ptype}] {ts} id={eid} call={call_id}", f"  {name}({preview})",
                         overview=[OverviewLine(eid, ts, "tool", f"{name} {raw}", limit=OVERVIEW_TOOL_TRUNC)])
        if codex_is_output_type(ptype):
            output = payload.get("output", "")
            if isinstance(output, dict):
                output = output.get("content", "") or json.dumps(output, ensure_ascii=False)
            call_id = payload.get("call_id", payload.get("id", "?"))
            status = payload.get("status")
            status_text = f"status={status} " if status else ""
            return Entry(eid, ts, "tool_result", f"[{ptype}] {ts} id={eid} call={call_id}", f"  output: {single_line(str(output), RESULT_TRUNC)}",
                         overview=[OverviewLine(eid, ts, "result", f"{status_text}{output}",
                                                limit=OVERVIEW_RESULT_TRUNC, preserve_tail=True)])

    return Entry(eid, ts, "other", f"[{entry.get('type', '?')}/{ptype}] {ts} id={eid}",
                 overview=[OverviewLine(eid, ts, "other", f"{entry.get('type', '?')}/{ptype}",
                                        limit=OVERVIEW_TOOL_TRUNC)])


class CodexAdapter:
    kind = "codex"

    @staticmethod
    def session_path(rec: Dict[str, Any]) -> Path:
        path = rec.get("persisted", {}).get("path")
        if path and Path(path).exists():
            return Path(path)
        # Prefer the stored session id. The cwd fallback is acceptable for
        # codex only because codex agents (unlike pi/claude) still launch
        # INSIDE their worktree — cwd is unique per agent, since codex
        # sessions bind by rollout payload.cwd and have no id-based binding.
        cwd = rec.get("persisted", {}).get("cwd") or rec.get("extra", {}).get("cwd")
        sid = rec.get("extra", {}).get("session_id")
        return codex_resolve_session(cwd, sid)

    @classmethod
    def read_persisted(cls, rec, count=None, use_cursor=True):
        path = cls.session_path(rec)
        raw_entries = codex_load_entries(path)
        indexed = codex_visible_indexed(raw_entries)
        cursor = load_cursor(rec["id"]) if use_cursor else None
        if cursor and cursor.get("session_path") == str(path):
            if "last_raw_idx" in cursor:
                last_raw_idx = int(cursor.get("last_raw_idx", -1))
            else:
                # Migrate the previous visible-index cursor without changing its
                # meaning when newly supported Codex tool types become visible.
                legacy = codex_visible_indexed(raw_entries, legacy=True)
                old_idx = int(cursor.get("last_idx", -1))
                last_raw_idx = legacy[old_idx][0] if 0 <= old_idx < len(legacy) else -1
            unread = [(i, e) for i, e in indexed if i > last_raw_idx]
            window = unread[:count] if count is not None else unread
        else:
            if cursor is None and len(indexed) > ESTABLISHED_THRESHOLD and count is None:
                raise ValueError(f"established session ({len(indexed)} entries) requires a cursor")
            window = indexed[-(count or RECENT_COUNT_DEFAULT):]
        rendered = [codex_format(e, i) for i, e in window]
        for formatted, (raw_index, _) in zip(rendered, window):
            formatted.cursor_after = {"session_path": str(path), "cursor_version": 2, "last_raw_idx": raw_index}
        last_raw_idx = window[-1][0] if window else (indexed[-1][0] if indexed else -1)
        new_cursor = {"session_path": str(path), "cursor_version": 2, "last_raw_idx": last_raw_idx}
        return rendered, new_cursor

    @classmethod
    def detail(cls, rec, target):
        path = cls.session_path(rec)
        entries = codex_load_entries(path)
        raw_match = re.fullmatch(r"codex-r(\d+)", target)
        if raw_match:
            raw_index = int(raw_match.group(1))
            if 0 <= raw_index < len(entries):
                return codex_format(entries[raw_index], raw_index).render()
        legacy_match = re.fullmatch(r"codex-(\d+)", target)
        if legacy_match:
            legacy = codex_visible_indexed(entries, legacy=True)
            visible_index = int(legacy_match.group(1))
            if 0 <= visible_index < len(legacy):
                raw_index, entry = legacy[visible_index]
                return codex_format(entry, raw_index).render()
        for raw_index, e in enumerate(entries):
            payload = e.get("payload", {})
            if payload.get("call_id") == target or payload.get("id") == target:
                return codex_format(e, raw_index).render()
        raise ValueError(f"id not found: {target}")

    @classmethod
    def raw_detail(cls, rec, target):
        entries = codex_load_entries(cls.session_path(rec))
        raw_match = re.fullmatch(r"codex-r(\d+)", target)
        if raw_match:
            raw_index = int(raw_match.group(1))
            if 0 <= raw_index < len(entries):
                return entries[raw_index]
        legacy_match = re.fullmatch(r"codex-(\d+)", target)
        if legacy_match:
            legacy = codex_visible_indexed(entries, legacy=True)
            visible_index = int(legacy_match.group(1))
            if 0 <= visible_index < len(legacy):
                return legacy[visible_index][1]
        matches = [entry for entry in entries
                   if (entry.get("payload") or {}).get("call_id") == target
                   or (entry.get("payload") or {}).get("id") == target]
        if len(matches) == 1:
            return matches[0]
        if len(matches) > 1:
            return matches
        raise ValueError(f"id not found: {target}")

    @classmethod
    def read_live(cls, rec):
        target = rec.get("live", {}).get("target")
        if not target:
            return "(no tmux target registered)"
        return tmux_capture(target, lines=120)

    @classmethod
    def send(cls, rec, text):
        target = rec.get("send", {}).get("target") or rec.get("live", {}).get("target")
        if not target:
            raise ValueError("codex: no tmux target for send")
        tmux_send_keys(target, text)

    @classmethod
    def turn_state(cls, rec) -> str:
        try:
            return codex_turn_state_from_entries(codex_load_entries(cls.session_path(rec)))
        except Exception:
            return "unknown"

    @classmethod
    def status_signals(cls, rec):
        try:
            path = cls.session_path(rec)
            age = time.time() - path.stat().st_mtime
            raw_entries = codex_load_entries(path)
            indexed = codex_visible_indexed(raw_entries)
        except Exception:
            return {
                "turn": "unknown", "persisted_age_s": float("inf"),
                "context_input_tokens": None, "context_window_tokens": None,
                "unread_count": None, "latest_marker": None,
            }
        cursor = load_cursor(rec["id"])
        if cursor is None:
            unread = len(indexed)
        elif cursor.get("session_path") != str(path):
            unread = None
        else:
            try:
                if "last_raw_idx" in cursor:
                    last_raw_idx = int(cursor.get("last_raw_idx", -1))
                else:
                    legacy = codex_visible_indexed(raw_entries, legacy=True)
                    old_idx = int(cursor.get("last_idx", -1))
                    last_raw_idx = legacy[old_idx][0] if 0 <= old_idx < len(legacy) else -1
                unread = sum(raw_index > last_raw_idx for raw_index, _ in indexed)
            except (TypeError, ValueError):
                unread = None
        recent = [codex_format(entry, raw_index) for raw_index, entry in indexed[-50:]]
        ctx, window = codex_last_context_tokens_from_entries(raw_entries)
        return {
            "turn": codex_turn_state_from_entries(raw_entries),
            "persisted_age_s": age,
            "context_input_tokens": ctx,
            "context_window_tokens": window,
            "unread_count": unread,
            "latest_marker": latest_supervisory_marker(recent),
        }


def codex_turn_state_from_entries(entries: List[Dict[str, Any]]) -> str:
    for last in reversed(entries):
        payload = last.get("payload", {})
        ptype = payload.get("type")
        etype = last.get("type")
        if etype in {"session_meta", "turn_context"} or ptype in {"token_count", "reasoning"}:
            continue
        if etype == "event_msg":
            if ptype == "task_complete":
                return "idle"
            if ptype in {"task_started", "user_message"}:
                return "busy"
            if ptype == "agent_message":
                return "idle"
            continue
        if etype == "response_item":
            if codex_is_call_type(ptype) or codex_is_output_type(ptype):
                return "busy"
            if ptype == "message":
                role = payload.get("role")
                if role == "assistant":
                    return "idle"
                if role == "user":
                    return "busy"
                if role == "developer":
                    continue
            if ptype == "reasoning":
                return "busy"
            return "unknown"
    return "unknown"


def codex_last_context_tokens_from_entries(entries: List[Dict[str, Any]]) -> Tuple[Optional[int], Optional[int]]:
    """Codex input_tokens includes cached_input_tokens rather than adding it."""
    for entry in reversed(entries):
        payload = entry.get("payload", {})
        if entry.get("type") == "compacted" or (
            entry.get("type") == "event_msg" and payload.get("type") == "context_compacted"
        ):
            return (None, None)
        if entry.get("type") != "event_msg":
            continue
        if payload.get("type") != "token_count":
            continue
        info = payload.get("info", {})
        last = info.get("last_token_usage", {})
        try:
            input_t = int(last.get("input_tokens") or 0) or None
        except (TypeError, ValueError):
            input_t = None
        try:
            window = int(info.get("model_context_window") or 0) or None
        except (TypeError, ValueError):
            window = None
        if input_t is not None or window is not None:
            return (input_t, window)
    return (None, None)


# -- adapter: opencode --------------------------------------------------------

class OpenCodeAdapter:
    kind = "opencode"

    @staticmethod
    def directory(rec: Dict[str, Any]) -> str:
        return rec.get("extra", {}).get("directory") or "/"

    @staticmethod
    def session_id(rec: Dict[str, Any]) -> str:
        sid = rec.get("extra", {}).get("session_id")
        if not sid:
            raise ValueError("opencode: no session_id in registry")
        return sid

    @classmethod
    def read_persisted(cls, rec, count=None, use_cursor=True):
        sid = cls.session_id(rec)
        directory = cls.directory(rec)
        messages = http_get(f"/session/{sid}/message", directory=directory)
        if not isinstance(messages, list):
            raise ValueError("opencode: unexpected /message response")
        cursor = load_cursor(rec["id"]) if use_cursor else None
        if cursor and cursor.get("session_id") == sid:
            start = int(cursor.get("last_msg_count", 0))
            indexed = list(enumerate(messages[start:], start))
            window = indexed[:count] if count is not None else indexed
        else:
            if cursor is None and len(messages) > ESTABLISHED_THRESHOLD and count is None:
                raise ValueError(f"established session ({len(messages)} messages) requires a cursor")
            start = max(0, len(messages) - (count or RECENT_COUNT_DEFAULT))
            window = list(enumerate(messages[start:], start))
        message_ids = [str(m.get("id") or m.get("info", {}).get("id") or f"oc-{i}") for i, m in enumerate(messages)]
        prefix_by_id = unique_prefixes(message_ids)
        rendered = []
        for index, message in window:
            message_id = message_ids[index]
            formatted = oc_format_message(message, index, prefix_by_id.get(message_id, message_id))
            formatted.cursor_after = {"session_id": sid, "last_msg_count": index + 1}
            rendered.append(formatted)
        last_count = window[-1][0] + 1 if window else len(messages)
        new_cursor = {"session_id": sid, "last_msg_count": last_count}
        return rendered, new_cursor

    @classmethod
    def detail(cls, rec, target):
        sid = cls.session_id(rec)
        directory = cls.directory(rec)
        messages = http_get(f"/session/{sid}/message", directory=directory)
        ids = [str(m.get("id") or m.get("info", {}).get("id") or f"oc-{i}") for i, m in enumerate(messages)]
        parent_target = target.split("/", 1)[0]
        parent_id = resolve_unique_prefix(ids, parent_target, "opencode message id")
        index = ids.index(parent_id)
        message = messages[index]
        locator = unique_prefixes(ids).get(parent_id, parent_id)
        if "/" not in target:
            return oc_format_message(message, index, locator).render()
        suffix = target[len(parent_target):]
        match = re.fullmatch(r"/(tool|thinking|result)/(\d+)", suffix)
        if not match:
            raise ValueError(f"invalid opencode child locator: {target}")
        kind, number_text = match.groups()
        part_type = {"tool": "tool", "thinking": "reasoning", "result": "tool"}[kind]
        parts = [part for part in message.get("parts", []) if isinstance(part, dict) and part.get("type") == part_type]
        if kind == "result":
            parts = [part for part in parts if isinstance(part.get("state"), dict) and (
                part["state"].get("output") is not None or part["state"].get("error") is not None or
                part["state"].get("status") in {"completed", "done", "success", "error", "failed"}
            )]
        number = int(number_text)
        if number < 1 or number > len(parts):
            raise ValueError(f"opencode child locator not found: {target}")
        part = parts[number - 1]
        if kind == "thinking":
            text = part.get("text") or part.get("content") or ""
        else:
            state = part.get("state", {}) if isinstance(part.get("state"), dict) else {}
            value = state.get("input") if kind == "tool" else (state.get("output") or state.get("error"))
            text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
        shown, cut = clip_overview(text, DETAIL_COMPONENT_TRUNC, preserve_tail=True)
        return f"[{kind}] id={target}\n  {shown}" + (f"\n  ({kind} content shortened)" if cut else "")

    @classmethod
    def raw_detail(cls, rec, target):
        sid = cls.session_id(rec)
        messages = http_get(f"/session/{sid}/message", directory=cls.directory(rec))
        ids = [str(message.get("id") or message.get("info", {}).get("id") or f"oc-{index}")
               for index, message in enumerate(messages)]
        parent_target = target.split("/", 1)[0]
        parent_id = resolve_unique_prefix(ids, parent_target, "opencode message id")
        message = messages[ids.index(parent_id)]
        if "/" not in target:
            return message
        suffix = target[len(parent_target):]
        match = re.fullmatch(r"/(tool|thinking|result)/(\d+)", suffix)
        if not match:
            raise ValueError(f"invalid opencode child locator: {target}")
        kind, number_text = match.groups()
        part_type = {"tool": "tool", "thinking": "reasoning", "result": "tool"}[kind]
        parts = [part for part in message.get("parts", [])
                 if isinstance(part, dict) and part.get("type") == part_type]
        if kind == "result":
            parts = [part for part in parts if isinstance(part.get("state"), dict) and (
                part["state"].get("output") is not None or part["state"].get("error") is not None or
                part["state"].get("status") in {"completed", "done", "success", "error", "failed"}
            )]
        number = int(number_text)
        if number < 1 or number > len(parts):
            raise ValueError(f"opencode child locator not found: {target}")
        return parts[number - 1]

    @classmethod
    def read_live(cls, rec):
        try:
            status = http_get("/session/status", directory=cls.directory(rec))
        except Exception as e:
            return f"(opencode unreachable: {e})"
        sid = cls.session_id(rec)
        # /session/status returns a dict keyed by session id, e.g.
        # {"ses_abc": {"type": "busy"}} during an active turn, or {} when idle.
        if not isinstance(status, dict):
            return f"(unexpected /session/status shape: {type(status).__name__})"
        my = status.get(sid)
        if my:
            return json.dumps({sid: my}, indent=2)
        return f"(no /session/status entry for {sid} — session is idle)"

    @classmethod
    def send(cls, rec, text):
        sid = cls.session_id(rec)
        directory = cls.directory(rec)
        body = {"parts": [{"type": "text", "text": text}]}
        # Prefer prompt_async (non-blocking); fall back to /message if not available.
        code, resp = http_post(f"/session/{sid}/prompt_async", body, directory=directory)
        if code in (200, 202, 204):
            return
        if code == 404:
            code2, resp2 = http_post(f"/session/{sid}/message", body, directory=directory)
            if code2 in (200, 202, 204):
                return
            raise ValueError(f"opencode send failed: {code2} {resp2}")
        raise ValueError(f"opencode send failed: {code} {resp}")

    @classmethod
    def turn_state(cls, rec) -> str:
        try:
            sid = cls.session_id(rec)
            messages = http_get(f"/session/{sid}/message", directory=cls.directory(rec))
        except Exception:
            return "unknown"
        return oc_turn_state_from_messages(messages)

    @classmethod
    def status_signals(cls, rec):
        try:
            sid = cls.session_id(rec)
            directory = cls.directory(rec)
        except Exception:
            return {
                "turn": "unknown", "persisted_age_s": float("inf"),
                "context_input_tokens": None, "unread_count": None, "latest_marker": None,
            }
        try:
            messages = http_get(f"/session/{sid}/message", directory=directory)
            if not isinstance(messages, list):
                raise ValueError("opencode: unexpected /message response")
        except Exception:
            messages = None
        try:
            meta = http_get(f"/session/{sid}", directory=directory)
            updated_ms = (meta.get("time", {}) or {}).get("updated") or 0
            age = (time.time() - updated_ms / 1000) if updated_ms else float("inf")
        except Exception:
            age = float("inf")
        if messages is None:
            return {
                "turn": "unknown", "persisted_age_s": age, "context_input_tokens": None,
                "unread_count": None, "latest_marker": None,
            }
        cursor = load_cursor(rec["id"])
        if cursor is None:
            unread = len(messages)
        elif cursor.get("session_id") != sid:
            unread = None
        else:
            try:
                position = int(cursor.get("last_msg_count", 0))
                unread = max(0, len(messages) - position) if position <= len(messages) else None
            except (TypeError, ValueError):
                unread = None
        recent = [oc_format_message(message, index)
                  for index, message in list(enumerate(messages))[-50:]]
        return {
            "turn": oc_turn_state_from_messages(messages),
            "persisted_age_s": age,
            "context_input_tokens": oc_last_context_tokens_from_messages(messages),
            "unread_count": unread,
            "latest_marker": latest_supervisory_marker(recent),
        }


def oc_turn_state_from_messages(messages: Any) -> str:
    if not isinstance(messages, list) or not messages:
        return "unknown"
    last = messages[-1]
    info = last.get("info", last) if isinstance(last, dict) else {}
    role = info.get("role")
    if role == "user":
        return "busy"
    if role != "assistant":
        return "unknown"
    time_info = info.get("time") if isinstance(info.get("time"), dict) else {}
    if "completed" in time_info and time_info.get("completed") is None:
        return "busy"
    parts = last.get("parts", []) if isinstance(last, dict) else []
    for part in parts if isinstance(parts, list) else []:
        if part.get("type") != "tool":
            continue
        state = part.get("state", {}) if isinstance(part.get("state"), dict) else {}
        status = state.get("status")
        if status and status not in {"completed", "done", "success", "error", "failed"}:
            return "busy"
    return "idle"


def oc_last_context_tokens_from_messages(messages: Any) -> Optional[int]:
    """OpenCode prompt tokens are input plus cache.read; cache.read is additive."""
    if not isinstance(messages, list):
        return None
    for m in reversed(messages):
        info = m.get("info", {}) if isinstance(m, dict) else {}
        if info.get("role") != "assistant":
            continue
        tokens = info.get("tokens")
        if not isinstance(tokens, dict):
            continue
        try:
            input_t = int(tokens.get("input") or 0)
            cache = tokens.get("cache") or {}
            cache_read = int(cache.get("read") or 0) if isinstance(cache, dict) else 0
        except (TypeError, ValueError):
            continue
        total = input_t + cache_read
        if total > 0:
            return total
    return None


def oc_format_message(m: Dict[str, Any], idx: int, locator: Optional[str] = None) -> Entry:
    info = m.get("info", m)
    role = info.get("role", "?")
    mid = str(info.get("id") or m.get("id") or f"oc-{idx}")
    loc = locator or mid
    ts_raw = info.get("time", {}).get("created") if isinstance(info.get("time"), dict) else info.get("created")
    ts = fmt_ts(ts_raw)

    parts = m.get("parts", [])
    if not parts and "content" in info:
        parts = [{"type": "text", "text": info.get("content", "")}]

    if role == "assistant":
        body_lines: List[str] = []
        overview: List[OverviewLine] = []
        text_parts = [p.get("text", "") for p in parts if isinstance(p, dict) and p.get("type") == "text"]
        text = "\n".join(t for t in text_parts if t).strip()
        if text:
            body_lines.append("  text:")
            for line in trunc(text, TEXT_TRUNC).splitlines() or [""]:
                body_lines.append("    " + line)
            overview.append(OverviewLine(loc, ts, "assistant", text, preserve_tail=True))
        thinking_number = 0
        tool_number = 0
        result_number = 0
        for part in parts if isinstance(parts, list) else []:
            if not isinstance(part, dict):
                continue
            if part.get("type") == "reasoning":
                value = part.get("text") or part.get("content") or ""
                for label in reasoning_labels(value):
                    thinking_number += 1
                    body_lines.append(f"  intent: {label}")
                    overview.append(OverviewLine(f"{loc}/thinking/{thinking_number}", ts, "intent", label,
                                                 limit=OVERVIEW_INTENT_TRUNC, preserve_tail=True))
            if part.get("type") == "tool":
                tool_number += 1
                tool = part.get("tool", "?")
                state_obj = part.get("state", {}) if isinstance(part.get("state"), dict) else {}
                status = state_obj.get("status", "?")
                args = state_obj.get("input", part.get("input", {}))
                preview = claude_preview_args(args, ARGS_TRUNC)
                body_lines.append(f"  tool: {tool} state={status} {preview}")
                overview.append(OverviewLine(f"{loc}/tool/{tool_number}", ts, "tool",
                                             f"{tool} {claude_preview_args(args, OVERVIEW_TOOL_TRUNC)}",
                                             limit=OVERVIEW_TOOL_TRUNC))
                output = state_obj.get("output")
                error = state_obj.get("error")
                if output is not None or error is not None or status in {"completed", "done", "success", "error", "failed"}:
                    result_number += 1
                    value = error if error is not None else output
                    value_text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
                    body_lines.append(f"  result: {tool} state={status} {single_line(value_text, RESULT_TRUNC)}")
                    prefix = f"{tool} status={status} "
                    overview.append(OverviewLine(f"{loc}/result/{result_number}", ts, "result", prefix + value_text,
                                                 limit=OVERVIEW_RESULT_TRUNC, preserve_tail=True))
        if not overview:
            overview.append(OverviewLine(loc, ts, "assistant", "", limit=OVERVIEW_TOOL_TRUNC))
        return Entry(mid, ts, "assistant", f"[assistant] {ts} id={mid}", "\n".join(body_lines), overview=overview)

    if role == "user":
        text_parts = [p.get("text", "") for p in parts if isinstance(p, dict) and p.get("type") == "text"]
        text = "\n".join(t for t in text_parts if t).strip()
        body = "\n".join("    " + l for l in trunc(text, TEXT_TRUNC).splitlines() or [""])
        return Entry(mid, ts, "user", f"[user] {ts} id={mid}", "  text:\n" + body,
                     overview=[OverviewLine(loc, ts, "user", text, preserve_tail=True)])

    return Entry(mid, ts, role, f"[{role}] {ts} id={mid}",
                 overview=[OverviewLine(loc, ts, str(role), "", limit=OVERVIEW_TOOL_TRUNC)])


# -- adapter dispatch ---------------------------------------------------------

ADAPTERS = {
    "pi": PiAdapter,
    "claude": ClaudeAdapter,
    "codex": CodexAdapter,
    "opencode": OpenCodeAdapter,
}


def adapter_for(rec: Dict[str, Any]):
    kind = rec.get("kind")
    if kind not in ADAPTERS:
        raise ValueError(f"unknown worker kind: {kind}")
    return ADAPTERS[kind]


# -- experimental attention await --------------------------------------------

def await_entries(rec: Dict[str, Any]) -> Tuple[Path, List[Dict[str, Any]]]:
    """Current ordered event stream for file-backed experimental await."""
    kind = rec.get("kind")
    if kind == "pi":
        path = PiAdapter.session_path(rec)
        return path, pi_load_active(path)
    if kind == "claude":
        path = ClaudeAdapter.session_path(rec)
        return path, claude_load_entries(path)
    if kind == "codex":
        path = CodexAdapter.session_path(rec)
        return path, codex_load_entries(path)
    if kind == "opencode":
        raise ValueError(
            "await is experimental and does not yet support opencode; its compaction event "
            "shape must be established before it can safely act as an attention notifier"
        )
    raise ValueError(f"await: unsupported worker kind: {kind}")


def await_event_kind(kind: str, entry: Dict[str, Any]) -> Optional[str]:
    """Classify only structural attention events; never return message content."""
    if kind == "pi":
        if entry.get("type") == "compaction":
            return "compaction"
        if entry.get("type") != "message":
            return None
        msg = entry.get("message", {})
        if msg.get("role") != "assistant":
            return None
        content = msg.get("content", [])
        has_tool_call = any(
            isinstance(block, dict) and block.get("type") == "toolCall"
            for block in content if isinstance(content, list)
        )
        stop = str(msg.get("stopReason") or msg.get("stop_reason") or "").lower()
        return None if has_tool_call or stop in {"tooluse", "tool_use", "tool-use"} else "idle"

    if kind == "claude":
        if entry.get("type") == "system" and entry.get("subtype") == "compact_boundary":
            return "compaction"
        if entry.get("type") != "assistant":
            return None
        msg = entry.get("message", {})
        content = msg.get("content", [])
        has_tool_use = any(
            isinstance(block, dict) and block.get("type") == "tool_use"
            for block in content if isinstance(content, list)
        )
        stop = str(msg.get("stop_reason") or msg.get("stopReason") or "").lower()
        return None if has_tool_use or stop in {"tool_use", "tooluse", "tool-use"} else "idle"

    if kind == "codex":
        payload = entry.get("payload", {})
        ptype = payload.get("type") if isinstance(payload, dict) else None
        if entry.get("type") == "compacted" or (
            entry.get("type") == "event_msg" and ptype == "context_compacted"
        ):
            return "compaction"
        if entry.get("type") == "event_msg" and ptype == "task_complete":
            return "idle"
    return None


def await_turn_state(kind: str, entries: List[Dict[str, Any]]) -> str:
    if kind == "pi":
        return pi_turn_state_from_entries(entries)
    if kind == "claude":
        return claude_turn_state_from_entries(claude_visible(entries))
    if kind == "codex":
        # Only task lifecycle events are authoritative here. Codex may persist
        # assistant prose and then continue into more calls before task_complete.
        for entry in reversed(entries):
            payload = entry.get("payload", {})
            if entry.get("type") != "event_msg" or not isinstance(payload, dict):
                continue
            ptype = payload.get("type")
            if ptype == "task_complete":
                return "idle"
            if ptype in {"task_started", "user_message"}:
                return "busy"
        return codex_turn_state_from_entries(entries)
    return "unknown"


def await_cursor_position(rec: Dict[str, Any], path: Path,
                          entries: List[Dict[str, Any]]) -> Optional[int]:
    """Raw/active entry position acknowledged by the ordinary watch cursor."""
    cursor = load_cursor(rec["id"])
    if cursor is None or cursor.get("session_path") != str(path):
        return None
    kind = rec.get("kind")
    if kind == "pi":
        last_entry_id = cursor.get("last_entry_id")
        if not last_entry_id:
            return None
        ids = [str(entry.get("id")) for entry in entries]
        try:
            return ids.index(str(last_entry_id))
        except ValueError:
            return None
    if kind == "claude":
        last_entry_id = cursor.get("last_entry_id")
        if not last_entry_id:
            return None
        ids = [str(entry.get("uuid")) for entry in entries]
        try:
            return ids.index(str(last_entry_id))
        except ValueError:
            return None
    if kind == "codex":
        try:
            if "last_raw_idx" in cursor:
                position = int(cursor["last_raw_idx"])
                return position if -1 <= position < len(entries) else None
            legacy = codex_visible_indexed(entries, legacy=True)
            old_index = int(cursor.get("last_idx", -1))
            return legacy[old_index][0] if 0 <= old_index < len(legacy) else None
        except (TypeError, ValueError):
            return None
    return None


def await_unresolved_compaction(rec: Dict[str, Any], path: Path,
                                entries: List[Dict[str, Any]]) -> bool:
    """Whether the latest in-flight compaction remains unread by watch."""
    kind = str(rec.get("kind", ""))
    last_compaction = -1
    last_idle = -1
    for index, entry in enumerate(entries):
        event = await_event_kind(kind, entry)
        if event == "compaction":
            last_compaction = index
        elif event == "idle":
            last_idle = index
    if last_compaction <= last_idle:
        return False
    cursor_position = await_cursor_position(rec, path, entries)
    return cursor_position is None or cursor_position < last_compaction


def await_attention(worker_id: str, reason: str) -> None:
    print(f"ATTENTION {worker_id}: {reason}", flush=True)
    print(f"Run: superv watch {worker_id}", flush=True)


def await_stable_snapshot(rec: Dict[str, Any]) -> Tuple[Path, List[Dict[str, Any]], os.stat_result]:
    """Read a snapshot whose file identity and size stayed fixed while parsing."""
    path, _ = await_entries(rec)
    while True:
        before = path.stat()
        current_path, entries = await_entries(rec)
        after = current_path.stat()
        if current_path != path:
            raise ValueError(f"registered transcript path changed from {path} to {current_path}")
        before_key = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
        after_key = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
        if before_key == after_key:
            return path, entries, after


def cmd_await(args: argparse.Namespace) -> int:
    """One-shot experimental notifier for structural worker attention events."""
    rec = load_record(args.id)
    kind = rec.get("kind", "")
    try:
        path, entries, stat = await_stable_snapshot(rec)
    except OSError as error:
        await_attention(args.id, "STREAM RESYNC REQUIRED")
        eprint(f"await: cannot establish transcript snapshot: {error}")
        return 2

    if await_unresolved_compaction(rec, path, entries):
        await_attention(args.id, "COMPACTION")
        return 0

    turn = await_turn_state(kind, entries)
    if turn == "idle":
        await_attention(args.id, "IDLE")
        return 0
    if turn != "busy":
        await_attention(args.id, "STREAM RESYNC REQUIRED")
        eprint(f"await: worker turn state is {turn!r}; refusing to wait on an unknown premise")
        return 2

    identity = (stat.st_dev, stat.st_ino)
    last_size = stat.st_size
    baseline_count = len(entries)
    baseline_pi_leaf = str(entries[-1].get("id")) if kind == "pi" and entries else None
    poll_interval = float(os.environ.get("SUPERV_AWAIT_POLL_INTERVAL", "0.25"))
    if poll_interval <= 0:
        raise ValueError("SUPERV_AWAIT_POLL_INTERVAL must be positive")

    # Printing only after the baseline is fixed makes this line an arming
    # handshake for background-command hosts and tests.
    print(f"AWAIT {args.id}: CURRENTLY BUSY — waiting until the worker needs attention.", flush=True)

    while True:
        time.sleep(poll_interval)
        try:
            current_stat = path.stat()
        except OSError as error:
            await_attention(args.id, "STREAM RESYNC REQUIRED")
            eprint(f"await: transcript disappeared: {path}: {error}")
            return 2
        if (current_stat.st_dev, current_stat.st_ino) != identity or current_stat.st_size < last_size:
            await_attention(args.id, "STREAM RESYNC REQUIRED")
            eprint(f"await: transcript identity changed or shrank: {path}")
            return 2
        if current_stat.st_size == last_size:
            continue

        try:
            _, current = await_entries(rec)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            await_attention(args.id, "STREAM RESYNC REQUIRED")
            eprint(f"await: could not read updated transcript: {error}")
            return 2

        if kind == "pi":
            ids = [str(entry.get("id")) for entry in current]
            if baseline_pi_leaf is not None:
                if baseline_pi_leaf not in ids:
                    await_attention(args.id, "STREAM RESYNC REQUIRED")
                    eprint("await: pi active branch no longer contains the armed leaf")
                    return 2
                start = ids.index(baseline_pi_leaf) + 1
            else:
                start = 0
            new_entries = current[start:]
        else:
            if len(current) < baseline_count:
                await_attention(args.id, "STREAM RESYNC REQUIRED")
                eprint("await: transcript entry count decreased")
                return 2
            new_entries = current[baseline_count:]

        events = [await_event_kind(kind, entry) for entry in new_entries]
        if "compaction" in events:
            await_attention(args.id, "COMPACTION")
            return 0
        if "idle" in events:
            await_attention(args.id, "IDLE")
            return 0

        last_size = current_stat.st_size
        baseline_count = len(current)
        if kind == "pi" and current:
            baseline_pi_leaf = str(current[-1].get("id"))


# -- subcommands --------------------------------------------------------------

def cmd_list(args: argparse.Namespace) -> int:
    ensure_dirs()
    print("=== registered workers ===")
    for rec in list_records():
        print(f"  {rec['id']}  kind={rec['kind']}  live={rec.get('live', {})}")

    print("\n=== auto-discovered tmux panes (kind candidates) ===")
    for pane in tmux_list_panes():
        cmd = pane["cmd"]
        guess = None
        if cmd == "pi":
            guess = "pi"
        elif cmd == "claude":
            guess = "claude"
        elif cmd == "codex":
            guess = "codex"
        if guess:
            print(f"  {pane['target']}  cmd={cmd}  path={pane['path']}  -> kind={guess}")

    print("\n=== auto-discovered opencode sessions ===")
    try:
        sessions = http_get("/session", directory="/")
        if isinstance(sessions, list):
            for s in sessions[:20]:
                sid = s.get("id", "?")
                directory = s.get("directory", "?")
                title = (s.get("title") or "").strip()[:60]
                print(f"  {sid}  dir={directory}  title={title!r}")
    except Exception as e:
        print(f"  (opencode unreachable on {OC_BASE}: {e})")
    return 0


def acquire_context_window(rec: Dict[str, Any]) -> Optional[int]:
    """Registration-time context-window fallback.

    The value is stashed in rec["extra"]["context_window_tokens"]. Pi status
    normally resolves the active model through persisted history and its local
    model registry; this cache covers cases where that lookup is unavailable.
    Other adapters use the cache as described below. An unresolved window is
    not fatal: status prints an explicit unknown denominator.

    Per-kind sources:
      pi:       tmux status bar (fallback; look for `46.8%/1.0M` style fragment)
      claude:   tmux status bar after the tmux-agent-supervisor statusLine script is wired in
                (look for `ctx:1000k` fragment); requires `superv install-claude-statusline`
      codex:    None — Codex publishes the window per turn in the JSONL token_count event,
                so no register-time acquisition needed
      opencode: GET /provider, lookup providerID/modelID from latest message
    """
    kind = rec.get("kind")
    if kind == "codex":
        return None  # Codex publishes per-turn; status_signals reads from JSONL.

    if kind in ("pi", "claude"):
        target = rec.get("live", {}).get("target")
        if not target:
            return None
        live = tmux_capture(target, lines=120)
        if kind == "pi":
            # Pi status bar: "...46.8%/1.0M (auto)..."
            m = re.search(r"(\d+(?:\.\d+)?)%/(\d+(?:\.\d+)?)([kKmMgG])\b", live)
            if not m:
                return None
            try:
                value = float(m.group(2))
            except ValueError:
                return None
            unit = {"K": 1000, "M": 1_000_000, "G": 1_000_000_000}[m.group(3).upper()]
            return int(value * unit)
        else:  # claude
            # Our statusline script emits `ctx:1000k` — see scripts/claude-statusline.sh
            m = re.search(r"\bctx:(\d+)k\b", live)
            if m:
                try:
                    return int(m.group(1)) * 1000
                except ValueError:
                    return None
            return None

    if kind == "opencode":
        try:
            providers = http_get("/provider", directory=rec.get("extra", {}).get("directory") or "/")
        except Exception:
            return None
        # Need providerID + modelID from the latest assistant message to look up the limit.
        try:
            sid = OpenCodeAdapter.session_id(rec)
            directory = OpenCodeAdapter.directory(rec)
            messages = http_get(f"/session/{sid}/message", directory=directory)
        except Exception:
            return None
        provider_id = None
        model_id = None
        if isinstance(messages, list):
            for m in reversed(messages):
                info = m.get("info", {}) if isinstance(m, dict) else {}
                if info.get("role") == "assistant":
                    provider_id = info.get("providerID")
                    model_id = info.get("modelID")
                    if provider_id and model_id:
                        break
        if not (provider_id and model_id):
            return None
        try:
            for prov in providers.get("all", []):
                if prov.get("id") != provider_id:
                    continue
                model = (prov.get("models") or {}).get(model_id)
                if not model:
                    return None
                ctx = (model.get("limit") or {}).get("context")
                return int(ctx) if ctx else None
        except Exception:
            return None
    return None


def cmd_install_claude_statusline(args: argparse.Namespace) -> int:
    """Install the tmux-agent-supervisor Claude statusLine into ~/.claude/settings.json.

    The status line gives the operator an at-a-glance context-window display
    AND lets `superv register --kind claude` parse the model context window from
    the rendered tmux pane (one-time acquisition, cached in the worker registry).

    If the user already has a statusLine configured, this command refuses unless
    --force is passed.
    """
    settings_path = Path.home() / ".claude" / "settings.json"
    script_path = Path(__file__).resolve().parent / "claude-statusline.sh"
    if not script_path.exists():
        raise ValueError(f"statusline script not found at {script_path}")

    settings: Dict[str, Any] = {}
    if settings_path.exists():
        try:
            settings = json.loads(settings_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as e:
            raise ValueError(f"~/.claude/settings.json is not valid JSON: {e}")

    existing = settings.get("statusLine")
    if existing and not args.force:
        existing_cmd = existing.get("command") if isinstance(existing, dict) else None
        if existing_cmd and str(script_path) in existing_cmd:
            print(f"already installed: statusLine command points at {script_path}")
            return 0
        raise ValueError(
            f"~/.claude/settings.json already has a statusLine entry:\n"
            f"  {json.dumps(existing, indent=2)}\n"
            f"  pass --force to overwrite, or edit settings.json manually"
        )

    settings["statusLine"] = {
        "type": "command",
        "command": str(script_path),
    }
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    settings_path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    print(f"installed: statusLine -> {script_path}")
    print(f"  ({settings_path})")
    print("  restart any running Claude Code TUIs to pick up the change.")
    return 0


def cmd_register(args: argparse.Namespace) -> int:
    # Per-kind flag validation: reject flags that don't apply to the chosen kind.
    tmux_kinds = ("pi", "claude", "codex")
    if args.kind in tmux_kinds:
        if not args.tmux:
            raise ValueError(
                f"--tmux <session>:<window>.<pane> is required for kind={args.kind}\n"
                f"  example: superv register myworker --kind {args.kind} --tmux 0:my-window.0\n"
                f"  hint: run 'superv list' to see candidate tmux panes"
            )
        if args.oc_session:
            raise ValueError(f"--oc-session is only valid for kind=opencode, not kind={args.kind}")
        if args.kind != "pi" and (args.session_id or args.session_dir):
            raise ValueError(
                f"--session-id/--session-dir are only valid for kind=pi, not kind={args.kind}"
            )
    elif args.kind == "opencode":
        if not args.oc_session:
            raise ValueError(
                "--oc-session ses_... is required for kind=opencode\n"
                "  example: superv register myworker --kind opencode --oc-session ses_abc123\n"
                "  hint: run 'superv list' to see live opencode sessions"
            )
        if args.tmux:
            raise ValueError("--tmux is not valid for kind=opencode (opencode uses HTTP transport)")
        if args.session_id or args.session_dir:
            raise ValueError("--session-id/--session-dir are only valid for kind=pi")

    rec: Dict[str, Any] = {
        "id": args.id,
        "kind": args.kind,
        "live": {},
        "persisted": {},
        "send": {},
        "extra": {},
    }

    if args.kind in tmux_kinds:
        target = args.tmux
        cwd = tmux_pane_path(target)
        if cwd is None:
            raise ValueError(
                f"tmux target not found: {target}\n"
                f"  hint: run 'tmux list-panes -a' or 'superv list' to confirm the target exists"
            )
        rec["live"] = {"type": "tmux", "target": target}
        rec["send"] = {"type": "tmux", "target": target}

        if args.kind == "claude":
            pid = tmux_pane_pid(target)
            child = proc_descendants_running(pid, "claude") if pid else None
            if not child:
                if args.path:
                    rec["persisted"] = {"type": "jsonl", "path": args.path, "cwd": cwd}
                else:
                    raise ValueError(
                        f"could not find a running 'claude' process under tmux pane {target}\n"
                        f"  hint: ensure Claude Code is actually running in that pane,\n"
                        f"  or pass --path /home/user/.claude/projects/<key>/<sid>.jsonl explicitly"
                    )
            else:
                meta = CLAUDE_PID_META_DIR / f"{child}.json"
                if not meta.exists():
                    raise ValueError(
                        f"claude metadata file not found: {meta}\n"
                        f"  hint: this Claude version may not write per-pid metadata; pass --path explicitly"
                    )
                md = json.loads(meta.read_text())
                sid = md.get("sessionId")
                cwd2 = md.get("cwd") or cwd
                if not sid or not cwd2:
                    raise ValueError(f"claude metadata missing sessionId/cwd: {meta}")
                candidate = CLAUDE_PROJECTS_ROOT / claude_path_key_for_cwd(cwd2) / f"{sid}.jsonl"
                if not candidate.exists():
                    raise ValueError(
                        f"resolved claude session file does not exist: {candidate}\n"
                        f"  hint: send Claude at least one message so it writes its JSONL, then re-register"
                    )
                rec["extra"]["session_id"] = sid
                rec["persisted"] = {"type": "jsonl", "path": str(candidate), "cwd": cwd2}
        elif args.kind == "pi":
            # Pi panes carry no recoverable session identity (pi rewrites its
            # process title, erasing launch flags from /proc), and several pi
            # agents may share one cwd, so the session file must be named
            # explicitly — via the launch-seeded --session-id or via --path.
            # Recency never decides; without an exact identity we fail closed.
            if args.path:
                p = Path(args.path).expanduser()
                if not p.exists():
                    raise ValueError(f"--path does not exist: {args.path}")
                header = pi_read_session_header(p)
                if header is None:
                    raise ValueError(
                        f"--path is not a pi session file (first line must be a session header): {p}"
                    )
                header_id = header.get("id")
                if args.session_id and header_id != args.session_id:
                    raise ValueError(
                        f"--path and --session-id disagree: {p} has session id '{header_id}', "
                        f"not '{args.session_id}'"
                    )
                bound = find_record_bound_to(p)
                if bound is not None:
                    raise ValueError(
                        f"session file {p} is already bound to registered worker '{bound.get('id')}'\n"
                        f"  two supervision handles on one transcript means one of them is misbound.\n"
                        f"  If '{bound.get('id')}' is stale, run: superv unregister {bound.get('id')}"
                    )
                rec["persisted"] = {"type": "jsonl", "path": str(p), "cwd": cwd}
                if args.session_dir:
                    rec["persisted"]["session_dir"] = args.session_dir
                if header_id:
                    rec["extra"]["session_id"] = header_id
            elif args.session_id:
                p = pi_resolve_by_session_id(args.session_id, cwd, args.session_dir)
                bound = find_record_bound_to(p)
                if bound is not None:
                    raise ValueError(
                        f"session file {p} is already bound to registered worker '{bound.get('id')}'\n"
                        f"  two supervision handles on one transcript means one of them is misbound.\n"
                        f"  If '{bound.get('id')}' is stale, run: superv unregister {bound.get('id')}"
                    )
                rec["persisted"] = {"type": "jsonl", "path": str(p), "cwd": cwd}
                if args.session_dir:
                    rec["persisted"]["session_dir"] = args.session_dir
                rec["extra"]["session_id"] = args.session_id
            else:
                candidates = pi_candidate_lines(cwd, args.session_dir)
                candidate_block = (
                    "  session files in the pane's cwd (NOT auto-selected):\n" + "\n".join(candidates) + "\n"
                    if candidates else
                    "  (no session files found in the pane's cwd session directory)\n"
                )
                raise ValueError(
                    "pi registration needs an exact session identity: --session-id <id> or --path <file>\n"
                    "  why: a pane's pi process cannot be matched to a session file after launch\n"
                    "  (pi rewrites its process title, erasing launch flags), and picking the newest\n"
                    "  JSONL misbinds whenever several pi agents share a cwd or a stale transcript\n"
                    "  sits next to a fresh worker that has not flushed its file yet.\n"
                    + candidate_block +
                    "  remedies:\n"
                    "    - launch workers with an explicit id:  pi --session-id <id> ...\n"
                    "      then:  superv register <name> --kind pi --tmux <target> --session-id <id>\n"
                    "    - for a worker resumed with `pi --session <uuid>`, register with --session-id <uuid>\n"
                    "    - for an already-running worker without an id: run /session inside its TUI to see\n"
                    "      its session file, then pass --path <file>"
                )
        elif args.kind == "codex":
            if args.path:
                if not Path(args.path).exists():
                    raise ValueError(f"--path does not exist: {args.path}")
                rec["persisted"] = {"type": "jsonl", "path": args.path, "cwd": cwd}
            else:
                try:
                    p = codex_resolve_session(cwd, None)
                except ValueError as e:
                    raise ValueError(
                        f"could not auto-resolve codex rollout for cwd={cwd}: {e}\n"
                        f"  hint: send the worker at least one message so it writes a rollout JSONL, then re-register;\n"
                        f"  or pass --path /home/user/.codex/sessions/YYYY/MM/DD/rollout-...jsonl explicitly"
                    )
                rec["persisted"] = {"type": "jsonl", "path": str(p), "cwd": cwd}

    elif args.kind == "opencode":
        sid = args.oc_session
        try:
            meta = http_get(f"/session/{sid}", directory="/")
        except Exception as e:
            raise ValueError(
                f"could not fetch /session/{sid} from {OC_BASE}: {e}\n"
                f"  hint: ensure opencode is running on the expected port and the session id is correct\n"
                f"  override port: OPENCODE_BASE=http://host:port superv register ..."
            )
        directory = meta.get("directory")
        if not directory:
            raise ValueError(f"opencode session {sid} has no 'directory' field — cannot scope future requests")
        rec["extra"]["session_id"] = sid
        rec["extra"]["directory"] = directory
        rec["live"] = {"type": "http", "base": OC_BASE}
        rec["send"] = {"type": "http", "base": OC_BASE}
        rec["persisted"] = {"type": "http", "base": OC_BASE}

    # Reject if this ID is already registered — caller must unregister first.
    existing = registry_path(args.id)
    if existing.exists():
        raise ValueError(
            f"worker '{args.id}' is already registered at {existing}\n"
            f"  hint: run 'superv unregister {args.id}' first if you want to re-register"
        )

    # Best-effort one-time context-window acquisition (not fatal if it fails).
    try:
        ctx_window = acquire_context_window(rec)
        if ctx_window:
            rec["extra"]["context_window_tokens"] = ctx_window
    except Exception as e:
        eprint(f"warning: context-window acquisition failed ({e!r}); status will report an unknown denominator")

    save_record(rec)
    print(json.dumps(rec, indent=2))
    if args.kind == "claude" and "context_window_tokens" not in rec.get("extra", {}):
        eprint("hint: install the tmux-agent-supervisor statusLine for auto-percentage:")
        eprint("      superv install-claude-statusline")
    return 0


def cmd_name(args: argparse.Namespace) -> int:
    """Print the next available name from the pool."""
    ensure_dirs()
    taken = {p.stem for p in WORKERS_DIR.glob("*.json")}
    for name in NAME_POOL:
        if name not in taken:
            print(name)
            return 0
    raise ValueError(f"all {len(NAME_POOL)} names are taken — unregister a worker to free one")


def cmd_show(args: argparse.Namespace) -> int:
    rec = load_record(args.id)
    print(json.dumps(rec, indent=2))
    # Also list adjacent state files so the operator sees the full picture.
    print()
    print("--- side files ---")
    for label, path in [
        ("cursor",          cursor_path(args.id)),
        ("notes",           NOTES_DIR / f"{args.id}.md"),
        ("heartbeat",       HEARTBEATS_DIR / f"{args.id}.md"),
        ("heartbeat-state", HEARTBEATS_DIR / f"{args.id}.state.json"),
    ]:
        if path.exists():
            size = path.stat().st_size
            print(f"  {label}: {path} ({size} bytes)")
        else:
            print(f"  {label}: (none)")
    return 0


def cmd_unregister(args: argparse.Namespace) -> int:
    p = registry_path(args.id)
    if not p.exists():
        raise ValueError(
            f"no registry entry for {args.id} at {p}\n"
            f"  hint: run 'superv list' to see registered worker ids"
        )
    p.unlink()
    print(f"removed registry entry: {p}")
    if args.purge:
        purge_paths = [
            CURSORS_DIR / f"{args.id}.json",
            HEARTBEATS_DIR / f"{args.id}.md",
            HEARTBEATS_DIR / f"{args.id}.state.json",
            NOTES_DIR / f"{args.id}.md",
        ]
        for f in purge_paths:
            if f.exists():
                f.unlink()
                print(f"  purged: {f}")
    else:
        print("  (cursor, notes, heartbeat preserved — pass --purge to remove all state)")
    return 0


# -- pause / resume -----------------------------------------------------------

# Default resume-time CLI flags per agent kind. Conservative posture:
# autonomous mode (no permission prompts) for claude/codex; pi has no equivalent flag.
RESUME_DEFAULT_FLAGS: Dict[str, str] = {
    "pi": "",
    "claude": "--dangerously-skip-permissions",
    "codex": "--dangerously-bypass-approvals-and-sandbox",
}


def extract_session_id(rec: Dict[str, Any]) -> str:
    """Return the resume-able session ID for a worker, derived from the registry.

    For claude this is rec.extra.session_id (or the JSONL stem as fallback).
    For pi the JSONL filename is <ts>_<uuid>.jsonl and we want the uuid.
    For codex the rollout filename is rollout-<ISO>-<uuid>.jsonl and we
    extract the uuid (last 5 dash-separated tokens, since UUIDs have 4 dashes).
    """
    kind = rec.get("kind")
    if kind == "claude":
        sid = (rec.get("extra") or {}).get("session_id")
        if sid:
            return sid
        path = (rec.get("persisted") or {}).get("path")
        if path:
            return Path(path).stem
        raise ValueError("no claude session_id available (registry missing extra.session_id and persisted.path)")
    if kind == "pi":
        sid = (rec.get("extra") or {}).get("session_id")
        if sid:
            return sid
        path = (rec.get("persisted") or {}).get("path") or ""
        stem = Path(path).stem
        if "_" in stem:
            return stem.split("_", 1)[1]
        return stem
    if kind == "codex":
        path = (rec.get("persisted") or {}).get("path") or ""
        stem = Path(path).stem
        if stem.startswith("rollout-"):
            tokens = stem.split("-")
            # rollout-2026-05-08T01-23-45-<uuid8>-<uuid4>-<uuid4>-<uuid4>-<uuid12>
            # the last 5 tokens are the uuid
            if len(tokens) >= 5:
                return "-".join(tokens[-5:])
        return stem
    raise ValueError(f"resume not supported for kind={kind}")


def build_resume_cmd(rec: Dict[str, Any], extra_flags: str = "") -> str:
    """Construct the shell command to resume a worker's TUI session.

    extra_flags is appended verbatim (e.g. "--effort high --model claude-opus-4-7").
    Returns a string suitable for tmux send-keys.
    """
    kind = rec["kind"]
    sid = extract_session_id(rec)
    base = RESUME_DEFAULT_FLAGS.get(kind, "")
    if kind == "claude":
        parts = ["claude"]
        if base:
            parts.extend(base.split())
        parts.extend(["--resume", sid])
        if extra_flags:
            parts.extend(shlex.split(extra_flags))
        return " ".join(parts)
    if kind == "pi":
        # A worker launched with a custom --session-dir keeps its session file
        # outside pi's default lookup root, so resume must address the file by
        # path (and re-supply --session-dir for consistent in-session behavior).
        session_dir = (rec.get("persisted") or {}).get("session_dir")
        if session_dir:
            path = (rec.get("persisted") or {}).get("path") or ""
            parts = ["pi", "--session", shlex.quote(path), "--session-dir", shlex.quote(session_dir)]
        else:
            parts = ["pi", "--session", sid]
        if base:
            parts.extend(base.split())
        if extra_flags:
            parts.extend(shlex.split(extra_flags))
        return " ".join(parts)
    if kind == "codex":
        parts = ["codex", "resume", sid]
        if base:
            parts.extend(base.split())
        if extra_flags:
            parts.extend(shlex.split(extra_flags))
        return " ".join(parts)
    raise ValueError(f"resume not supported for kind={kind}")


def cmd_pause(args: argparse.Namespace) -> int:
    rec = load_record(args.id)
    kind = rec.get("kind")
    if kind not in ("pi", "claude", "codex"):
        raise ValueError(
            f"pause not supported for kind={kind}\n"
            f"  hint: pause/resume is for tmux-backed workers only (pi/claude/codex);\n"
            f"  opencode sessions live on the opencode server and don't need pause/resume"
        )

    target = (rec.get("live") or {}).get("target")
    if not target:
        raise ValueError(f"no tmux target stored for {args.id}; cannot pause")

    # Pre-flight: confirm we can build a resume command before killing anything.
    try:
        cmd = build_resume_cmd(rec, args.launch_hint or (rec.get("extra") or {}).get("launch_hint", ""))
    except ValueError as e:
        raise ValueError(
            f"cannot prepare resume command for {args.id}: {e}\n"
            f"  hint: registry entry may be incomplete; refusing to kill the tmux window"
        )

    rec.setdefault("extra", {})
    rec["extra"]["paused"] = True
    rec["extra"]["paused_at"] = now_iso()
    rec["extra"]["resume_cmd"] = cmd
    if args.launch_hint:
        rec["extra"]["launch_hint"] = args.launch_hint
    save_record(rec)

    # Kill the tmux window the pane belongs to (target is "session:window.pane").
    if "." in target:
        window = target.rsplit(".", 1)[0]
    else:
        window = target

    if args.keep_window:
        print(f"paused {args.id} (kind={kind}); tmux window {window} left intact (--keep-window)")
    else:
        with tmux_lock():
            try:
                r = subprocess.run(
                    ["tmux", "kill-window", "-t", window],
                    capture_output=True, text=True, check=False,
                )
                if r.returncode != 0:
                    eprint(f"warning: tmux kill-window {window} returned {r.returncode}: {r.stderr.strip()}")
            except Exception as e:
                eprint(f"warning: failed to run tmux kill-window: {e}")
        print(f"paused {args.id} (kind={kind}); killed tmux window {window}")

    print(f"  session preserved at: {(rec.get('persisted') or {}).get('path')}")
    print(f"  resume with: superv resume {args.id}")
    return 0


def cmd_resume(args: argparse.Namespace) -> int:
    rec = load_record(args.id)
    kind = rec.get("kind")
    if kind not in ("pi", "claude", "codex"):
        raise ValueError(f"resume not supported for kind={kind}")

    if not (rec.get("extra") or {}).get("paused"):
        eprint(f"note: {args.id} is not marked paused; resuming anyway (use --force to silence)")

    cwd = args.cwd or (rec.get("persisted") or {}).get("cwd")
    if not cwd:
        raise ValueError(f"no cwd stored for {args.id}; pass --cwd <path>")
    if not Path(cwd).exists():
        raise ValueError(
            f"cwd does not exist: {cwd}\n"
            f"  hint: pi/claude workers store the worktrees' parent folder as cwd, which outlives\n"
            f"  worktree rotation — if even that is gone, something upstream moved. codex workers\n"
            f"  still store the worktree itself and may need --cwd <path> after it is deleted."
        )

    extra_flags = args.launch_hint or (rec.get("extra") or {}).get("launch_hint", "")
    cmd = build_resume_cmd(rec, extra_flags)

    # --cwd relocates the worker, and persisted.path is cwd-adjacent state:
    # leaving it stale would force later reads onto the resolve-by-recency
    # fallback, which can grab another agent's transcript. Re-resolve the
    # transcript by session id up front, or refuse before touching tmux.
    repointed_path: Optional[str] = None
    if args.cwd:
        sid = extract_session_id(rec)
        try:
            if kind == "pi":
                p = pi_resolve_by_session_id(sid, None, (rec.get("persisted") or {}).get("session_dir"))
            elif kind == "claude":
                p = claude_resolve_session(None, sid)
            else:
                p = codex_resolve_session(None, sid)
        except ValueError as e:
            raise ValueError(
                f"--cwd was passed, but persisted.path could not be re-resolved by session id '{sid}': {e}\n"
                f"  refusing to resume with a cwd that no longer matches the stored transcript path.\n"
                f"  Inspect with 'superv show {args.id}', fix persisted.path, or re-register with --path."
            )
        repointed_path = str(p)

    # Determine target tmux session and window.
    prev_target = (rec.get("live") or {}).get("target", "")
    if ":" in prev_target:
        prev_session, rest = prev_target.split(":", 1)
        prev_window = rest.split(".", 1)[0]
    else:
        prev_session, prev_window = "0", args.id

    tmux_session = args.tmux_session or prev_session
    new_window = args.window or prev_window or args.id

    with tmux_lock():
        # Kill any existing window with that name (clean slate); ignore errors.
        subprocess.run(
            ["tmux", "kill-window", "-t", f"{tmux_session}:{new_window}"],
            capture_output=True, check=False,
        )

        # Create the window in the chosen cwd.
        r = subprocess.run(
            ["tmux", "new-window", "-t", f"{tmux_session}:", "-n", new_window, "-d", "-c", cwd],
            capture_output=True, text=True, check=False,
        )
        if r.returncode != 0:
            raise ValueError(f"tmux new-window failed: {r.stderr.strip() or 'unknown error'}")

        new_target = f"{tmux_session}:{new_window}.0"

        # Send the resume command.
        subprocess.run(
            ["tmux", "send-keys", "-t", new_target, cmd, "Enter"],
            capture_output=True, check=False,
        )

    # Update registry to reflect the new pane address and clear paused state.
    rec.setdefault("live", {})["type"] = "tmux"
    rec["live"]["target"] = new_target
    rec.setdefault("send", {})["type"] = "tmux"
    rec["send"]["target"] = new_target
    rec.setdefault("extra", {})
    rec["extra"]["paused"] = False
    rec["extra"]["resumed_at"] = now_iso()
    if args.cwd:
        # If the user resumed in a different cwd, update the stored cwd too,
        # since future re-pause/re-resume should use the new location — and
        # keep persisted.path in step (re-resolved by session id above).
        rec.setdefault("persisted", {})
        rec["persisted"]["cwd"] = cwd
        if repointed_path:
            rec["persisted"]["path"] = repointed_path
    save_record(rec)

    print(f"resumed {args.id} (kind={kind}) in tmux {new_target}")
    print(f"  cwd: {cwd}")
    print(f"  command: {cmd}")
    return 0


def _overview_page(entries: List[Entry]) -> List[Entry]:
    """Largest oldest contiguous entry page whose compact overview fits."""
    page: List[Entry] = []
    for entry in entries:
        candidate = page + [entry]
        if page and len(render_overview(candidate)) > MAX_RENDERED_CHARS:
            break
        page.append(entry)
        # A single persisted message can contain several calls. Keep it
        # atomic so advancing the entry cursor never hides an unrendered call.
        if len(render_overview(page)) > MAX_RENDERED_CHARS:
            break
    return page


def cmd_watch(args: argparse.Namespace) -> int:
    # Flag interactions:
    #   --live alone         → read live channel only; cursor flags are nonsensical here
    #   --reset              → delete cursor before reading; persisted read uses recent tail
    #   --full               → read from the start; cursor advances only through represented entries
    #   --count N            → bootstrap tail, or oldest N unread when a cursor exists
    if args.live:
        for flag in ("reset", "full", "count", "force"):
            if getattr(args, flag):
                raise ValueError(
                    f"watch --live: --{flag} is not valid in live mode\n"
                    f"  --live reads only the tmux pane / http status — there's no cursor or count.\n"
                    f"  drop --live to use cursor flags, or drop --{flag} to keep --live."
                )

    rec = load_record(args.id)
    adapter = adapter_for(rec)

    if args.live:
        print(adapter.read_live(rec))
        return 0

    if args.count is not None and args.count <= 0:
        raise ValueError("watch --count must be a positive integer")

    if args.reset:
        reset_cursor(args.id)

    use_cursor = not args.full
    # --reset without an explicit count deliberately reboots from the normal
    # recent tail instead of asking an established session to dump its history.
    read_count = args.count if args.count is not None else (RECENT_COUNT_DEFAULT if args.reset else None)
    if args.full and args.count is None:
        read_count = sys.maxsize
    entries, new_cursor = adapter.read_persisted(rec, count=read_count, use_cursor=use_cursor)

    if not entries:
        print("(no new entries)")
        save_cursor(args.id, new_cursor)
        return 0

    detailed = render_entries(entries)
    if len(detailed) <= MAX_RENDERED_CHARS or args.force:
        print(detailed)
        save_cursor(args.id, new_cursor)
        if args.count is None and not args.reset:
            print(f"\nOBSERVATION COMPLETE — {len(entries)}/{len(entries)} unread entries shown; cursor advanced through all.")
        print(f"\n(cursor: {cursor_path(args.id)})")
        return 0

    page = _overview_page(entries)
    complete = len(page) == len(entries)
    print(f"COMPACT OVERVIEW — detailed content shortened ({len(entries)} unread entries)\n")
    print(render_overview(page))
    if any(entry.overview_was_truncated() for entry in page):
        print(f"\nLines ending in … were shortened. Use `superv detail {args.id} <locator>` to inspect one entry.")

    cursor_to_save = new_cursor if complete else page[-1].cursor_after
    if cursor_to_save is None:
        raise ValueError("internal error: overview page has no cursor boundary")
    save_cursor(args.id, cursor_to_save)

    if complete:
        print(f"\nOBSERVATION COMPLETE — {len(page)}/{len(entries)} unread entries shown (compact); cursor advanced through all.")
    else:
        remaining = len(entries) - len(page)
        print(f"\n⚠ INCOMPLETE OBSERVATION — {len(page)}/{len(entries)} unread entries shown; {remaining} remain.")
        print(f"Cursor advanced through shown entries only. Run again: superv watch {args.id}")
        print("Repeat until OBSERVATION COMPLETE.")
        print(f"Intentional skip: superv watch {args.id} --reset --count <N> (discards unread remainder).")
    print(f"\n(cursor: {cursor_path(args.id)})")
    return 0


def cmd_detail(args: argparse.Namespace) -> int:
    rec = load_record(args.id)
    adapter = adapter_for(rec)
    if args.raw != args.force:
        raise ValueError("unbounded raw detail requires both --raw and --force")
    try:
        if args.raw:
            print(json.dumps(adapter.raw_detail(rec, args.entry_id), indent=2, ensure_ascii=False))
            return 0
        rendered = adapter.detail(rec, args.entry_id)
        if len(rendered) <= MAX_RENDERED_CHARS:
            print(rendered)
        else:
            shown, _ = clip_overview(rendered, MAX_RENDERED_CHARS, preserve_tail=True)
            print(shown)
            print(f"\nDETAIL SHORTENED — original rendered content was {len(rendered)} characters.")
            print("Use a child tool/result locator when available to inspect that component directly.")
    except ValueError as e:
        eprint(f"error: {e}")
        return 1
    return 0


def cmd_recent(args: argparse.Namespace) -> int:
    """Non-mutating query over recent persisted content."""
    if args.count <= 0:
        raise ValueError("recent --count must be a positive integer")
    rec = load_record(args.id)
    adapter = adapter_for(rec)
    entries, _ = adapter.read_persisted(rec, count=sys.maxsize, use_cursor=False)
    lines = [line for entry in entries for line in entry.overview]
    if args.kind == "messages":
        lines = [line for line in lines if line.kind in {"assistant", "user", "intent"}]
    elif args.kind == "tools":
        lines = [line for line in lines if line.kind in {"tool", "result"}]
    elif args.kind == "errors":
        pattern = re.compile(r"\b(error|failed|failure)\b|\bexit=[1-9]\d*", re.I)
        lines = [line for line in lines if pattern.search(line.text)]
    selected = lines[-args.count:]
    if not selected:
        print("(no matching recent entries)")
        return 0
    print("\n".join(line.render() for line in selected))
    if any(line.truncated for line in selected):
        print(f"\nLines ending in … were shortened. Use `superv detail {args.id} <locator>` to inspect one entry.")
    print("\n(recent query did not move the watch cursor)")
    return 0


def _snapshot_entry_ids(adapter, rec: Dict[str, Any]) -> set:
    """Return the set of persisted entry ids visible right now (no cursor)."""
    try:
        entries, _ = adapter.read_persisted(rec, count=20, use_cursor=False)
    except Exception:
        return set()
    return {e.id for e in entries}


def _is_compaction_command(text: str) -> bool:
    """True if the message is a harness compaction command rather than agent input.

    Compaction is a runtime operation, not an agent turn: it produces no persisted
    entry, so --verify's polling can never observe it. See send_cmd for why that
    matters.
    """
    if not text:
        return False
    first = text.strip().splitlines()[0].strip() if text.strip() else ""
    return first == "/compact" or first.startswith("/compact ")


def _verify_send_landed(adapter, rec: Dict[str, Any], pre_ids: set, timeout_s: float = 6.0) -> bool:
    """Poll persisted history until a new entry id appears (signaling our send landed)."""
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        time.sleep(0.5)
        try:
            entries, _ = adapter.read_persisted(rec, count=20, use_cursor=False)
        except Exception:
            continue
        if any(e.id not in pre_ids for e in entries):
            return True
    return False


def cmd_send(args: argparse.Namespace) -> int:
    # Mutual exclusion: exactly one of (positional message, --file) must be given.
    if args.message and args.file:
        raise ValueError(
            "send: pass either a positional message OR --file <path>, not both\n"
            "  examples:\n"
            "    superv send <id> 'Continue.'\n"
            "    superv send <id> --file /tmp/instruction.md"
        )
    if not args.message and not args.file:
        raise ValueError(
            "send: provide a message (positional) or --file <path>\n"
            "  examples:\n"
            "    superv send <id> 'Continue.'\n"
            "    superv send <id> --file /tmp/instruction.md"
        )

    rec = load_record(args.id)
    adapter = adapter_for(rec)
    transport = rec.get("send", {}).get("type")

    # Snapshot persisted entries before send, for --verify polling later.
    pre_ids = _snapshot_entry_ids(adapter, rec) if args.verify else None

    if args.file:
        path = Path(args.file)
        if not path.exists():
            raise ValueError(f"--file path does not exist: {path}")
        text = path.read_text(encoding="utf-8")
        if not text.strip():
            raise ValueError(f"--file is empty: {path}")
        adapter.send(rec, text)
        sent_text = text
        print(f"sent {len(text)} chars from {path} via {transport}.")
    else:
        adapter.send(rec, args.message)
        sent_text = args.message
        print(f"sent via {transport}.")

    if _is_compaction_command(sent_text):
        print(
            "\n"
            + ("!! VERIFY SKIPPED — A COMPACTION COMMAND CANNOT BE VERIFIED THIS WAY. !!\n"
               if args.verify else
               "!! COMPACTION SENT — ITS COMPLETION CANNOT BE OBSERVED FROM SUPERV. !!\n")
            + "\n"
            "Compaction is a harness operation, not an agent turn. It writes no persisted\n"
            "entry, so polling for one proves nothing: a worker that compacted successfully\n"
            "and is now waiting looks exactly like one that never received the command.\n"
            "The same is true of `ctx=`, `persisted_age` and `unread` in `superv status` —\n"
            "all three are absences of output, and a healthy compacted worker produces them.\n"
            "\n"
            "DO NOT re-send /compact to find out whether the first one worked. A second\n"
            "compaction can land on an already-compacted worker and discard the context it\n"
            "just rebuilt.\n"
            "\n"
            "CORRECT PROCEDURE:\n"
            "  1. Send /compact once, and send the post-compaction orientation in the same turn.\n"
            "  2. On each SUBSEQUENT heartbeat, check whether it finished by reading the harness\n"
            "     display. This is the normal validation step, not a last resort:\n"
            f"       tmux capture-pane -p -t <target>   # target: superv show {args.id}\n"
            "  3. Never re-send /compact to find out whether the first one worked.\n"
        )
        return 0

    if args.verify:
        landed = _verify_send_landed(adapter, rec, pre_ids, timeout_s=args.verify_timeout)
        if not landed and transport == "tmux":
            # Composer-Enter quirk: prompt may be sitting in the composer.
            # Send a bare Enter and try once more.
            print("verify: no new entry seen yet — sending a bare Enter to nudge submission")
            target = rec.get("send", {}).get("target") or rec.get("live", {}).get("target")
            if target:
                tmux_send_enter(target)
            landed = _verify_send_landed(adapter, rec, pre_ids, timeout_s=args.verify_timeout)
        if not landed:
            raise ValueError(
                "verify: no new persisted entry appeared within "
                f"{args.verify_timeout}s after sending. The send may have been swallowed "
                "(composer-Enter quirk, busy worker, or wrong target). Inspect with:\n"
                f"  superv watch {args.id} --live\n"
                f"  superv watch {args.id} --reset --count 5"
            )
        print("verify: confirmed — a new persisted entry appeared.")
    return 0


def status_line(rec: Dict[str, Any], sig: Dict[str, Any], *, include_latest: bool = False) -> str:
    turn = sig.get("turn", "unknown")
    age = sig.get("persisted_age_s", float("inf"))
    broken = sig.get("broken", False)

    # A trailing busy entry can outlive a dead process. persisted_age remains
    # visible so the supervisor can distinguish fresh work from that condition.
    if broken or turn == "unknown":
        verdict = "broken"
    elif turn == "busy":
        verdict = "running"
    elif age < 600:
        verdict = "idle"
    else:
        verdict = "stalled"

    age_min = age / 60 if age != float("inf") else None
    age_str = f"{age_min:.1f}m" if age_min is not None else "?"
    unread = sig.get("unread_count")
    parts = [
        f"id={rec['id']}",
        f"kind={rec['kind']}",
        f"status={verdict}",
        f"turn={turn}",
        f"persisted_age={age_str}",
        f"unread={unread if unread is not None else '?'}",
    ]

    ctx_tokens = sig.get("context_input_tokens")
    ctx_window = sig.get("context_window_tokens") or rec.get("extra", {}).get("context_window_tokens")
    if ctx_tokens:
        if ctx_window:
            pct = (ctx_tokens / ctx_window) * 100
            parts.append(f"ctx={ctx_tokens / 1000:.0f}k/{ctx_window / 1000:.0f}k({pct:.0f}%)")
        else:
            parts.append(f"ctx={ctx_tokens / 1000:.0f}k/?")

    if include_latest and sig.get("latest_marker"):
        kind, text = sig["latest_marker"]
        shown, _ = clip_overview(text, 140)
        parts.append(f"latest_{kind}={json.dumps(shown, ensure_ascii=False)}")
    return " ".join(parts)


def cmd_status(args: argparse.Namespace) -> int:
    rec = load_record(args.id)
    print(status_line(rec, adapter_for(rec).status_signals(rec)))
    return 0


def cmd_sweep(args: argparse.Namespace) -> int:
    """Concise routing view across registered workers; never moves cursors."""
    records = [load_record(worker_id) for worker_id in args.ids] if args.ids else list_records()
    if not records:
        print("(no registered workers)")
        return 0
    failed = False
    for rec in records:
        try:
            print(status_line(rec, adapter_for(rec).status_signals(rec), include_latest=True))
        except Exception as error:
            failed = True
            message, _ = clip_overview(str(error), 180, preserve_tail=True)
            print(f"id={rec.get('id', '?')} kind={rec.get('kind', '?')} status=broken unread=? error={json.dumps(message)}")
    return 1 if failed else 0


def cmd_note(args: argparse.Namespace) -> int:
    if args.tag not in ("user", "supervisor", "self"):
        eprint("note: --tag must be one of user|supervisor|self")
        return 1
    ensure_dirs()
    notes_path = NOTES_DIR / f"{args.id}.md"
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"\n### {ts} [{args.tag}-directed]\n{args.text}\n"
    with notes_path.open("a", encoding="utf-8") as f:
        f.write(line)
    print(f"appended to {notes_path}")
    return 0


def cmd_heartbeat(args: argparse.Namespace) -> int:
    if not (args.bump or args.reset or args.teardown or args.show):
        raise ValueError(
            "heartbeat: pass exactly one of --bump --reset --teardown --show\n"
            "  --reset:    initialize a fresh instruction file at start interval (30s)\n"
            "  --bump:     advance backoff by +30s (cap 240s) and rewrite the file\n"
            "  --teardown: remove the file when overall supervision is complete, requires user input, or the user says stop\n"
            "  --show:     print the current file contents\n"
            f"  example: superv heartbeat {args.id} --bump"
        )
    # Confirm the worker exists before doing anything else.
    load_record(args.id)
    ensure_dirs()
    hb_path = HEARTBEATS_DIR / f"{args.id}.md"
    state_path = HEARTBEATS_DIR / f"{args.id}.state.json"

    if args.teardown:
        existing = [path for path in (hb_path, state_path) if path.exists()]
        if not existing:
            raise ValueError(f"heartbeat --teardown: no heartbeat state for {args.id}")
        for path in existing:
            path.unlink()
            print(f"teardown: removed {path}")
        return 0

    if args.show:
        if not hb_path.exists():
            raise ValueError(
                f"heartbeat --show: no heartbeat file at {hb_path}\n"
                f"  hint: 'superv heartbeat {args.id} --reset' to create one"
            )
        print(hb_path.read_text(encoding="utf-8"))
        return 0

    if args.reset:
        next_sleep = HEARTBEAT_START
    else:  # args.bump
        prev = 0
        if state_path.exists():
            state = json.loads(state_path.read_text(encoding="utf-8"))
            prev = int(state.get("next_sleep", 0))
        elif hb_path.exists():
            # Migrate heartbeat files generated before timer metadata moved to
            # the sidecar. The prompt itself is rewritten canonically below.
            m = re.search(r"^next_sleep=(\d+)", hb_path.read_text(encoding="utf-8"), flags=re.M)
            if m:
                prev = int(m.group(1))
        next_sleep = min(HEARTBEAT_CAP, prev + HEARTBEAT_STEP) if prev else HEARTBEAT_START

    rec = load_record(args.id)
    hb_path.write_text(f"{CANONICAL_HEARTBEAT_PROMPT}\n", encoding="utf-8")
    state_path.write_text(json.dumps({
        "next_sleep": next_sleep,
        "anchor_worker": args.id,
        "anchor_worker_kind": rec["kind"],
    }, indent=2) + "\n", encoding="utf-8")
    print(f"wrote {hb_path}")
    print(f"\nnext step: sleep {next_sleep} && cat {hb_path}")
    return 0


# -- argparse -----------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="superv",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Unified agent supervision CLI — supervise Claude / Pi / Codex / OpenCode workers.",
        epilog="""\
typical workflows:

  attach to a running worker:
    # 1. you launch the worker yourself with whatever tooling fits (tmux + the agent's CLI,
    #    or just opening Claude Code / opencode by hand). superv does NOT launch agents.
    # 2. once the worker has produced its first output (so its session file exists), register:
    superv list                                   # see candidate tmux panes / oc sessions
    superv register my-worker --kind <kind> [--tmux T:W.P | --oc-session ses_...]
    superv watch my-worker --count 3              # initial bootstrap of cursor
    superv watch my-worker                        # incremental polling thereafter

  send a message:
    superv send my-worker "Continue."
    superv send my-worker --file /tmp/long-instruction.md

  classify and observe:
    superv sweep                                  # route attention across every worker
    superv status my-worker
    superv await my-worker                        # experimental one-shot attention wait
    superv watch my-worker
    superv watch my-worker --live                 # live channel only
    superv recent my-worker --kind messages       # query without moving cursor
    superv detail my-worker <entry-id>            # bounded content for one entry

  heartbeat (polled supervisors only — codex/opencode):
    superv heartbeat my-worker --reset            # initial 30s
    superv heartbeat my-worker --bump             # +30s, cap 240s
    superv heartbeat my-worker --teardown         # only when overall supervision should stop

  notes:
    superv note my-worker "blocked on dep X" --tag supervisor

state location: ~/.agent-supervision/{workers,cursors,notes,heartbeats}/
""",
    )
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    # list
    sp = sub.add_parser(
        "list",
        help="auto-discover candidate workers (tmux panes + opencode sessions)",
        description="Show registered workers, candidate tmux panes running pi/claude/codex, and OpenCode sessions on http://localhost:4096.",
    )
    sp.set_defaults(func=cmd_list)

    # register
    sp = sub.add_parser(
        "register",
        help="register a running worker by id",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Register a new worker. Fails if the id is already taken — unregister first to re-use an id. Auto-resolves session/transcript path from the transport.",
        epilog="""\
required flags by kind:
  --kind pi      requires --tmux T:W.P and an exact session identity:
                   --session-id <id>   the id the worker was launched with
                                       (pi --session-id <id>, or the uuid in pi --session <uuid>)
                   or --path <file>    explicit session JSONL
                 pi sessions are never auto-resolved by recency — several pi agents may
                 share one cwd, so registration fails closed without an exact identity.
  --kind claude  requires --tmux T:W.P                (auto-resolves PID → sessionId → JSONL)
  --kind codex   requires --tmux T:W.P                (auto-resolves cwd → rollout JSONL)
  --kind opencode requires --oc-session ses_...       (auto-resolves directory via http)

pi timing note: pi writes its session file on its first assistant reply. Registering
--session-id before the worker's first turn fails with "no session file found ... yet";
retry after the first turn (the triad launcher polls for this automatically).

examples:
  superv register tv-pi   --kind pi   --tmux 0:pi-worker.0 --session-id tv-pi-01983c
  superv register c-acp   --kind claude --tmux 0:claude.0
  superv register oc-impl --kind opencode --oc-session ses_29ab1c5e...
""",
    )
    sp.add_argument("id", help="stable id you'll use for all subsequent superv commands")
    sp.add_argument("--kind", required=True, choices=list(ADAPTERS.keys()))
    sp.add_argument("--tmux", help="tmux target for tmux-backed kinds, e.g. 0:my-window.0")
    sp.add_argument("--oc-session", help="opencode session id, e.g. ses_29ab...; only valid for --kind opencode")
    sp.add_argument("--path", help="explicit session/JSONL path override (skips auto-resolution)")
    sp.add_argument("--session-id", help="pi only: exact session id the worker was launched with (pi --session-id)")
    sp.add_argument("--session-dir", help="pi only: custom session directory the worker was launched with (pi --session-dir)")
    sp.set_defaults(func=cmd_register)

    # name
    sp = sub.add_parser(
        "name",
        help="print next available worker name from the pool",
        description="Returns the first unused name from the built-in name pool (checks the registry). Use this to pick a name before creating a tmux window and registering.",
    )
    sp.set_defaults(func=cmd_name)

    # install-claude-statusline
    sp = sub.add_parser(
        "install-claude-statusline",
        help="install the tmux-agent-supervisor statusLine into ~/.claude/settings.json",
        description="Wires scripts/claude-statusline.sh as the Claude Code statusLine. Gives the operator a context-window display in the TUI status bar AND lets `superv register --kind claude` parse the model context window from a tmux capture (one-time acquisition, cached in the worker registry).",
    )
    sp.add_argument("--force", action="store_true", help="overwrite an existing statusLine entry")
    sp.set_defaults(func=cmd_install_claude_statusline)

    # show
    sp = sub.add_parser(
        "show",
        help="show full registry record + side files for one worker",
        description="Print the full registry record for a worker id (paths, extras) and list which side files (cursor, notes, heartbeat) currently exist for it.",
    )
    sp.add_argument("id")
    sp.set_defaults(func=cmd_show)

    # unregister
    sp = sub.add_parser(
        "unregister",
        help="remove a worker registry entry",
        description="Remove the registry entry. Cursor, notes, and heartbeat are preserved by default; pass --purge to remove everything.",
    )
    sp.add_argument("id")
    sp.add_argument("--purge", action="store_true", help="also delete cursor, notes, and heartbeat files")
    sp.set_defaults(func=cmd_unregister)

    # pause
    sp = sub.add_parser(
        "pause",
        help="terminate the worker's tmux window but preserve its session for later resume",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Kill the worker's tmux window. The persisted session file (Pi/Claude JSONL, Codex rollout) is left intact. The registry entry is marked paused with a stored resume command. Resume later with 'superv resume <id>'.",
        epilog="""\
behavior by kind:
  pi      kills tmux window; resume re-launches with `pi --session <uuid>`
  claude  kills tmux window; resume re-launches with `claude --resume <uuid> --dangerously-skip-permissions`
  codex   kills tmux window; resume re-launches with `codex resume <uuid> --dangerously-bypass-approvals-and-sandbox`
  opencode  not supported — opencode sessions live on the opencode server, no pause needed

examples:
  superv pause my-worker                                # kill tmux window, store resume cmd
  superv pause my-worker --launch-hint "--effort high"  # capture custom flags for resume
  superv pause my-worker --keep-window                  # mark paused but don't kill tmux yet
""",
    )
    sp.add_argument("id")
    sp.add_argument("--launch-hint", help="extra flags to use when resuming (e.g. '--effort high'); appended to the default resume command")
    sp.add_argument("--keep-window", action="store_true", help="mark paused but don't actually kill the tmux window (dry-run-ish)")
    sp.set_defaults(func=cmd_pause)

    # resume
    sp = sub.add_parser(
        "resume",
        help="re-launch a paused worker into a fresh tmux window, continuing the same session",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Create a new tmux window in the worker's stored cwd and launch the agent CLI with the appropriate session-resume flag. The registry entry is updated with the new tmux target.",
        epilog="""\
session-id resolution:
  pi      <uuid> from the JSONL filename (<ts>_<uuid>.jsonl)
  claude  rec.extra.session_id (or JSONL stem fallback)
  codex   <uuid> from the rollout filename (rollout-<ISO>-<uuid>.jsonl)

cwd:
  defaults to the cwd recorded at register time (rec.persisted.cwd).
  pass --cwd <path> to resume from a different directory (e.g. if the
  original was a deleted worktree). agents inherit cwd from the resuming
  process, so this affects what file paths the agent thinks are relative.

examples:
  superv resume my-worker                                  # default cwd, default flags
  superv resume my-worker --cwd /home/user/workspace/repo  # resume from a different dir
  superv resume my-worker --window my-worker-2             # use a different tmux window name
  superv resume my-worker --launch-hint "--effort high"    # add extra flags
""",
    )
    sp.add_argument("id")
    sp.add_argument("--cwd", help="override stored cwd")
    sp.add_argument("--window", help="tmux window name (default: previous window name)")
    sp.add_argument("--tmux-session", help="tmux session (default: previous tmux session)")
    sp.add_argument("--launch-hint", help="extra flags to append to the resume command")
    sp.set_defaults(func=cmd_resume)

    # watch
    sp = sub.add_parser(
        "watch",
        help="incremental view of new persisted entries (or --live for live channel)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Read new persisted entries past the cursor, or read the live channel with --live.",
        epilog="""\
modes:
  default              read entries past the cursor (cursor advances)
  --reset              discard cursor and rebootstrap from the recent tail
  --full               read from the start; partial overview pages advance only through shown entries
  --count N            bootstrap tail, or oldest N unread when a cursor exists
  --live               read the live channel only (tmux pane / http status); cursor flags forbidden

overflow:
  detailed output that exceeds 12000 characters becomes a compact chronological overview.
  every tool call remains on its own line. INCOMPLETE OBSERVATION means you must run watch
  again before judging the worker; repeat until OBSERVATION COMPLETE.

bootstrap rule:
  on a session with >20 entries and no cursor, watch refuses unless --count or --reset is given.
  this prevents accidentally dumping a huge history into the supervisor's context.

examples:
  superv watch tv-pi                  # incremental: only new entries since cursor
  superv watch tv-pi --count 8        # bootstrap tail, or next 8 unread with a cursor
  superv watch tv-pi --reset          # deliberately discard unread history; show default tail
  superv watch tv-pi --live           # current tmux pane / http status
""",
    )
    sp.add_argument("id")
    sp.add_argument("--live", action="store_true", help="read live channel only (no cursor)")
    sp.add_argument("--reset", action="store_true", help="delete cursor before reading")
    sp.add_argument("--full", action="store_true", help="ignore cursor for this read")
    sp.add_argument("--count", type=int, help="show last N entries (bootstrap mode)")
    sp.add_argument("--force", action="store_true", help="bypass the safety cap (max 12000 rendered chars)")
    sp.set_defaults(func=cmd_watch)

    # recent
    sp = sub.add_parser(
        "recent",
        help="query recent persisted content without moving the watch cursor",
        description="Show recent compact messages, tool activity, errors, or all content. This is a read-only historical query and never updates the watch cursor.",
    )
    sp.add_argument("id")
    sp.add_argument("--kind", choices=["messages", "tools", "errors", "all"], default="messages")
    sp.add_argument("--count", type=int, default=3, help="number of matching compact lines to show (default: 3)")
    sp.set_defaults(func=cmd_recent)

    # detail
    sp = sub.add_parser(
        "detail",
        help="bounded content for one entry (use when watch's overview is shortened)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Show supervisor-oriented content for one persisted entry while omitting opaque signatures and bounding large text, tool arguments, and results.",
        epilog="""\
entry-id formats:
  pi       entry id, toolCallId, or displayed child locator
  claude   unique entry prefix, tool id, or displayed child locator
  codex    codex-rN from watch output, legacy codex-N, or a call_id
  opencode unique message prefix or displayed child locator

examples:
  superv detail tv-pi a6ca92b7
  superv detail tv-pi a6ca92b7/tool/1
  superv detail c-acp tool_01ABC
  superv detail c1 codex-r12
  superv detail c1 codex-r12 --raw --force   # explicit unbounded JSON override
""",
    )
    sp.add_argument("id")
    sp.add_argument("entry_id", help="entry id, tool call id, or worker-specific identifier from watch output")
    sp.add_argument("--raw", action="store_true", help="print the persisted JSON object; requires --force")
    sp.add_argument("--force", action="store_true", help="confirm unbounded raw output; requires --raw")
    sp.set_defaults(func=cmd_detail)

    # send
    sp = sub.add_parser(
        "send",
        help="send a message to the worker (any text, single or multi-line)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Send a message via the worker's send transport. Exactly one of (positional message, --file) is required.",
        epilog="""\
transport behavior:
  tmux  any text → tmux paste-buffer (-d -p -r) + Enter; multi-line is preserved as soft newlines
  http  any text → POSTed directly to the worker's prompt endpoint

examples:
  superv send tv-pi "Continue."
  superv send tv-pi "multi-line text
goes here as one message"
  superv send tv-pi --file /tmp/instruction.md
""",
    )
    sp.add_argument("id")
    sp.add_argument("message", nargs="?", help="message text (positional, exclusive with --file); single or multi-line")
    sp.add_argument("--file", help="path to a file whose contents are sent (exclusive with positional message)")
    sp.add_argument("--verify", action="store_true",
                    help="poll persisted history after sending; if no new entry appears within --verify-timeout, retry one bare Enter (tmux only) and fail loudly if still missing")
    sp.add_argument("--verify-timeout", type=float, default=6.0,
                    help="seconds to wait per verify attempt (default: 6.0)")
    sp.set_defaults(func=cmd_send)

    # status
    sp = sub.add_parser(
        "status",
        help="mechanical liveness verdict (running/idle/stalled/broken)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Mechanical verdict from persisted transcript turn-state + persisted age + reachability. Does NOT classify WORKER_COMPLETE or NEEDS_CORRECTION — those require reading content (use 'superv watch') and applying agent judgment.",
        epilog="""\
mechanical verdicts (script outputs):
  running   transcript turn-state is busy
  idle      transcript turn-state is idle and persisted age < 10min
  stalled   transcript turn-state is idle and persisted age > 10min
  broken    transcript turn-state is unknown or live channel unreachable

agent-judgment verdicts (NOT script outputs — read content to decide):
  WORKER_COMPLETE  worker's current assignment met, validations actually ran, no pending blocker
  NEEDS_CORRECTION worker progressing in a wrong direction (anti-pattern detected)

typical use: status narrows the worker-level question; the global supervisor still reassesses the overall goal.
  - 'running' → do not nudge this worker solely because the heartbeat fired
  - 'idle' / 'stalled' → run 'superv watch' and read recent entries to decide what's really going on
  - 'broken' → escalate; do not nudge a dead worker
""",
    )
    sp.add_argument("id")
    sp.set_defaults(func=cmd_status)

    # await (experimental)
    sp = sub.add_parser(
        "await",
        help="experimental: block until a worker needs supervisory attention",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Experimental one-shot attention notifier. Exits when the worker is idle, compacts, or its persisted stream requires resynchronization. It never prints worker message content and never moves the watch cursor.",
        epilog="""\
experimental event-driven supervision:
  Dispatch and verify work, then run this command through the supervisor host's
  background-command facility. Its completion is an alert; always run `superv watch`
  to interpret the authoritative persisted stream. Do not rearm while the worker is idle.

attention events:
  IDLE                    the worker reached a terminal turn, or was idle at startup
  COMPACTION              a compaction boundary appeared; continuation is unpredictable
  STREAM RESYNC REQUIRED  the stream changed identity, shrank, branched away, or is unknown

currently supported: pi, claude, codex. OpenCode is rejected until its real
compaction event shape is established.
""",
    )
    sp.add_argument("id")
    sp.set_defaults(func=cmd_await)

    # sweep
    sp = sub.add_parser(
        "sweep",
        help="concise status, unread count, context, and latest intent across workers",
        description="Route attention across all registered workers, or the worker ids supplied. This reads persisted state without moving any watch cursor.",
    )
    sp.add_argument("ids", nargs="*", help="worker ids (default: all registered workers)")
    sp.set_defaults(func=cmd_sweep)

    # note
    sp = sub.add_parser(
        "note",
        help="append a timestamped tagged entry to the worker's notes file",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Append a tagged observation. The tag attributes who drove the decision; this matters because the worker has multiple principals.",
        epilog="""\
--tag values:
  user        the user talked to the worker directly
  supervisor  you (the supervisor) sent a nudge or instruction
  self        the worker made its own decision

example:
  superv note tv-pi "blocked on hermes 401; restarted token via X" --tag supervisor
""",
    )
    sp.add_argument("id")
    sp.add_argument("text")
    sp.add_argument("--tag", required=True, choices=["user", "supervisor", "self"])
    sp.set_defaults(func=cmd_note)

    # heartbeat
    sp = sub.add_parser(
        "heartbeat",
        help="manage the polled-supervisor heartbeat instruction file",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Create / advance / inspect / remove the heartbeat instruction file. For scheduled supervisors, prefer the native scheduling primitives instead: ScheduleWakeup or CronCreate on Claude, schedule_loop_wakeup or LoopCreate on Pi.",
        epilog="""\
modes (exactly one required):
  --reset      initialize/reset the file at the start interval (30s)
  --bump       advance backoff: +30s per call, capped at 240s
  --show       print the current file contents
  --teardown   remove the file only when overall supervision is complete, requires user input, or the user says stop

after --reset or --bump, the script prints the next 'sleep N && cat <path>' command for you to run.

example session:
  superv heartbeat tv-pi --reset            # 30s
  # ...run printed sleep+cat...
  superv heartbeat tv-pi --bump             # 60s
  # ...continue until done, then:
  superv heartbeat tv-pi --teardown
""",
    )
    sp.add_argument("id")
    sp.add_argument("--bump", action="store_true")
    sp.add_argument("--reset", action="store_true")
    sp.add_argument("--teardown", action="store_true")
    sp.add_argument("--show", action="store_true")
    sp.set_defaults(func=cmd_heartbeat)

    return p


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except ValueError as e:
        eprint(f"error: {e}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
